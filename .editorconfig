# Editor defaults for Ruvia. These encode what the tree already does -- every
# rule here was verified against the checked-in files, so applying them cannot
# reformat existing code.
#
# Line wrapping is deliberately not specified. Ruvia breaks lines where the
# meaning divides, not at a fixed column, which is why the project ships no
# .clang-format: no mechanical column rule reproduces the existing style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[.clang-tidy]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false
