{
  "name": "ruvia",
  "version-string": "0.1.4",
  "default-features": [
    "runtime",
    "protocol",
    "framework"
  ],
  "features": {
    "runtime": {
      "description": "Dependencies for the ruvia-core runtime library.",
      "dependencies": [
        "asio",
        "mimalloc"
      ]
    },
    "allocator-override": {
      "description": "Override the process allocator with mimalloc.",
      "dependencies": [
        {
          "name": "mimalloc",
          "features": [
            "override"
          ],
          "platform": "!windows | !static"
        }
      ]
    },
    "protocol": {
      "description": "Dependencies for the standalone ruvia-http protocol library.",
      "dependencies": [
        "brotli",
        "zlib",
        "zstd"
      ]
    },
    "framework": {
      "description": "Dependencies for the complete ruvia-web framework.",
      "dependencies": [
        "openssl"
      ]
    },
    "edge": {
      "description": "Dependencies for the ruvia-edge CDN edge node library.",
      "dependencies": [
        "openssl"
      ]
    },
    "jwt": {
      "description": "Build HMAC JWT helper APIs."
    },
    "mariadb": {
      "description": "Build MariaDB-compatible database APIs.",
      "dependencies": [
        "libmariadb"
      ]
    },
    "postgresql": {
      "description": "Build PostgreSQL database APIs.",
      "dependencies": [
        "libpq"
      ]
    },
    "redis": {
      "description": "Build Redis client APIs.",
      "dependencies": [
        "hiredis"
      ]
    }
  }
}
