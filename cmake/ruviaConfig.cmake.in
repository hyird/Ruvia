@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(ruvia_VERSION "@PROJECT_VERSION@")
set(RUVIA_ENABLE_MARIADB @RUVIA_ENABLE_MARIADB@)
set(RUVIA_ENABLE_POSTGRESQL @RUVIA_ENABLE_POSTGRESQL@)
set(RUVIA_ENABLE_REDIS @RUVIA_ENABLE_REDIS@)
set(RUVIA_ENABLE_JWT @RUVIA_ENABLE_JWT@)

set(ruvia_AVAILABLE_COMPONENTS)
foreach(_ruvia_component IN ITEMS core http web)
    set(ruvia_${_ruvia_component}_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ruvia-${_ruvia_component}-targets.cmake")
        list(APPEND ruvia_AVAILABLE_COMPONENTS ${_ruvia_component})
    endif()
endforeach()
list(FIND ruvia_AVAILABLE_COMPONENTS core _ruvia_core_available)
list(FIND ruvia_AVAILABLE_COMPONENTS http _ruvia_http_available)
list(FIND ruvia_AVAILABLE_COMPONENTS web _ruvia_web_available)
if(_ruvia_web_available GREATER -1 AND
   (_ruvia_core_available EQUAL -1 OR _ruvia_http_available EQUAL -1))
    list(REMOVE_ITEM ruvia_AVAILABLE_COMPONENTS web)
endif()

set(_ruvia_requested ${ruvia_FIND_COMPONENTS})
if(NOT _ruvia_requested)
    set(ruvia_FOUND FALSE)
    set(ruvia_NOT_FOUND_MESSAGE
        "find_package(ruvia) requires at least one explicit component: core, http, or web")
    return()
endif()
list(FIND _ruvia_requested web _ruvia_web_requested)
if(_ruvia_web_requested GREATER -1)
    list(APPEND _ruvia_requested core http)
endif()
list(REMOVE_DUPLICATES _ruvia_requested)
list(FIND _ruvia_requested core _ruvia_core_requested)
list(FIND _ruvia_requested http _ruvia_http_requested)
list(FIND _ruvia_requested web _ruvia_web_requested)

if(_ruvia_core_requested GREATER -1)
    find_dependency(asio CONFIG)
    find_dependency(Threads)
endif()
if(_ruvia_http_requested GREATER -1)
    find_dependency(ZLIB)
    find_dependency(unofficial-brotli CONFIG)
    find_dependency(zstd CONFIG)
endif()
if(_ruvia_web_requested GREATER -1)
    find_dependency(OpenSSL)
endif()
if(_ruvia_web_requested GREATER -1 AND RUVIA_ENABLE_MARIADB)
    find_dependency(unofficial-libmariadb CONFIG)
endif()
if(_ruvia_web_requested GREATER -1 AND RUVIA_ENABLE_POSTGRESQL)
    find_dependency(PostgreSQL)
endif()
if(_ruvia_web_requested GREATER -1 AND RUVIA_ENABLE_REDIS)
    find_dependency(hiredis CONFIG)
endif()

foreach(_ruvia_component IN ITEMS core http web)
    list(FIND _ruvia_requested ${_ruvia_component} _ruvia_component_requested)
    list(FIND ruvia_AVAILABLE_COMPONENTS ${_ruvia_component} _ruvia_component_available)
    if(_ruvia_component_requested GREATER -1 AND
       _ruvia_component_available GREATER -1)
        include("${CMAKE_CURRENT_LIST_DIR}/ruvia-${_ruvia_component}-targets.cmake")
        set(ruvia_${_ruvia_component}_FOUND TRUE)
    endif()
endforeach()

check_required_components(ruvia)
