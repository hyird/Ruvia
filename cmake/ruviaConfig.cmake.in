@PACKAGE_INIT@

set(ruvia_VERSION "@PROJECT_VERSION@")
set(RUVIA_ENABLE_MARIADB @RUVIA_ENABLE_MARIADB@)
set(RUVIA_ENABLE_POSTGRESQL @RUVIA_ENABLE_POSTGRESQL@)
set(RUVIA_ENABLE_REDIS @RUVIA_ENABLE_REDIS@)
set(RUVIA_ENABLE_JWT @RUVIA_ENABLE_JWT@)
set(ruvia_AVAILABLE_COMPONENTS)
foreach(component IN ITEMS core http web)
    set(ruvia_${component}_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ruvia-${component}-targets.cmake")
        list(APPEND ruvia_AVAILABLE_COMPONENTS ${component})
    endif()
endforeach()
if(NOT ruvia_FIND_COMPONENTS)
    set(ruvia_FOUND FALSE)
    set(ruvia_NOT_FOUND_MESSAGE "find_package(ruvia) requires explicit components: core, http, or web")
    return()
endif()

include(CMakeFindDependencyMacro)
set(requested ${ruvia_FIND_COMPONENTS})
if(web IN_LIST requested AND web IN_LIST ruvia_AVAILABLE_COMPONENTS)
    list(APPEND requested core http)
endif()
foreach(component IN ITEMS core http web)
    if(NOT component IN_LIST requested OR NOT component IN_LIST ruvia_AVAILABLE_COMPONENTS)
        continue()
    endif()
    if(component STREQUAL "core")
        find_dependency(asio CONFIG)
        find_dependency(Threads)
    elseif(component STREQUAL "http")
        find_dependency(ZLIB)
        find_dependency(unofficial-brotli CONFIG)
        find_dependency(zstd CONFIG)
        find_dependency(ngtcp2 1.25.0 CONFIG)
    elseif(ruvia_core_FOUND AND ruvia_http_FOUND)
        find_dependency(OpenSSL 3.5 COMPONENTS SSL Crypto)
        if(RUVIA_ENABLE_MARIADB)
            find_dependency(unofficial-libmariadb CONFIG)
        endif()
        if(RUVIA_ENABLE_POSTGRESQL)
            find_dependency(PostgreSQL)
        endif()
        if(RUVIA_ENABLE_REDIS)
            find_dependency(hiredis CONFIG)
        endif()
    else()
        continue()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/ruvia-${component}-targets.cmake")
    set(ruvia_${component}_FOUND TRUE)
endforeach()

# Controller archives register through static initialization.
if(ruvia_web_FOUND)
    function(ruvia_link_controllers application)
        if(NOT TARGET "${application}")
            message(FATAL_ERROR "ruvia_link_controllers requires an existing application target")
        endif()
        foreach(controller IN LISTS ARGN)
            if(NOT TARGET "${controller}")
                message(FATAL_ERROR "ruvia_link_controllers target does not exist: ${controller}")
            endif()
            get_target_property(type "${controller}" TYPE)
            if(type STREQUAL "STATIC_LIBRARY")
                target_link_libraries("${application}" PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${controller}>")
            elseif(type STREQUAL "OBJECT_LIBRARY")
                target_sources("${application}" PRIVATE "$<TARGET_OBJECTS:${controller}>")
            else()
                message(FATAL_ERROR "ruvia_link_controllers accepts only STATIC_LIBRARY or OBJECT_LIBRARY targets")
            endif()
        endforeach()
    endfunction()
endif()
check_required_components(ruvia)
