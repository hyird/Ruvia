@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(ruvia_VERSION "@PROJECT_VERSION@")
set(RUVIA_ENABLE_MARIADB @RUVIA_ENABLE_MARIADB@)
set(RUVIA_ENABLE_POSTGRESQL @RUVIA_ENABLE_POSTGRESQL@)
set(RUVIA_ENABLE_REDIS @RUVIA_ENABLE_REDIS@)
set(RUVIA_ENABLE_JWT @RUVIA_ENABLE_JWT@)

set(ruvia_AVAILABLE_COMPONENTS)
foreach(_ruvia_component IN ITEMS core http web)
    set(ruvia_${_ruvia_component}_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ruvia-${_ruvia_component}-targets.cmake")
        list(APPEND ruvia_AVAILABLE_COMPONENTS ${_ruvia_component})
    endif()
endforeach()
list(FIND ruvia_AVAILABLE_COMPONENTS core _ruvia_core_available)
list(FIND ruvia_AVAILABLE_COMPONENTS http _ruvia_http_available)
list(FIND ruvia_AVAILABLE_COMPONENTS web _ruvia_web_available)
if(_ruvia_web_available GREATER -1 AND
   (_ruvia_core_available EQUAL -1 OR _ruvia_http_available EQUAL -1))
    list(REMOVE_ITEM ruvia_AVAILABLE_COMPONENTS web)
    set(_ruvia_web_available -1)
endif()

set(_ruvia_requested ${ruvia_FIND_COMPONENTS})
if(NOT _ruvia_requested)
    set(ruvia_FOUND FALSE)
    set(ruvia_NOT_FOUND_MESSAGE
        "find_package(ruvia) requires at least one explicit component: core, http, or web")
    return()
endif()
list(FIND _ruvia_requested web _ruvia_web_requested)
if(_ruvia_web_requested GREATER -1 AND _ruvia_web_available GREATER -1)
    list(APPEND _ruvia_requested core http)
endif()
list(REMOVE_DUPLICATES _ruvia_requested)
list(FIND _ruvia_requested core _ruvia_core_requested)
list(FIND _ruvia_requested http _ruvia_http_requested)
list(FIND _ruvia_requested web _ruvia_web_requested)

# A missing optional dependency disables only its component. Required
# components keep find_dependency's diagnostics and early return.
macro(_ruvia_find_component_dependency package)
    if(_ruvia_component_ready)
        if(_ruvia_component_required)
            find_dependency(${package} ${ARGN})
        else()
            find_package(${package} QUIET ${ARGN})
            if(NOT ${package}_FOUND)
                set(_ruvia_component_ready FALSE)
            endif()
        endif()
    endif()
endmacro()

set(_ruvia_core_ready FALSE)
if(_ruvia_core_requested GREATER -1 AND _ruvia_core_available GREATER -1)
    set(_ruvia_component_ready TRUE)
    set(_ruvia_component_required FALSE)
    if(ruvia_FIND_REQUIRED_core OR
       (_ruvia_web_requested GREATER -1 AND ruvia_FIND_REQUIRED_web))
        set(_ruvia_component_required TRUE)
    endif()
    _ruvia_find_component_dependency(asio CONFIG)
    _ruvia_find_component_dependency(Threads)
    set(_ruvia_core_ready ${_ruvia_component_ready})
endif()

set(_ruvia_http_ready FALSE)
if(_ruvia_http_requested GREATER -1 AND _ruvia_http_available GREATER -1)
    set(_ruvia_component_ready TRUE)
    set(_ruvia_component_required FALSE)
    if(ruvia_FIND_REQUIRED_http OR
       (_ruvia_web_requested GREATER -1 AND ruvia_FIND_REQUIRED_web))
        set(_ruvia_component_required TRUE)
    endif()
    _ruvia_find_component_dependency(ZLIB)
    _ruvia_find_component_dependency(unofficial-brotli CONFIG)
    _ruvia_find_component_dependency(zstd CONFIG)
    set(_ruvia_http_ready ${_ruvia_component_ready})
endif()

set(_ruvia_web_ready FALSE)
if(_ruvia_web_requested GREATER -1 AND _ruvia_web_available GREATER -1 AND
   _ruvia_core_ready AND _ruvia_http_ready)
    set(_ruvia_component_ready TRUE)
    set(_ruvia_component_required ${ruvia_FIND_REQUIRED_web})
    _ruvia_find_component_dependency(OpenSSL)
    if(RUVIA_ENABLE_MARIADB)
        _ruvia_find_component_dependency(unofficial-libmariadb CONFIG)
    endif()
    if(RUVIA_ENABLE_POSTGRESQL)
        _ruvia_find_component_dependency(PostgreSQL)
    endif()
    if(RUVIA_ENABLE_REDIS)
        _ruvia_find_component_dependency(hiredis CONFIG)
    endif()
    set(_ruvia_web_ready ${_ruvia_component_ready})
endif()

foreach(_ruvia_component IN ITEMS core http web)
    if(_ruvia_${_ruvia_component}_ready)
        include("${CMAKE_CURRENT_LIST_DIR}/ruvia-${_ruvia_component}-targets.cmake")
        set(ruvia_${_ruvia_component}_FOUND TRUE)
    endif()
endforeach()

# Controller translation units register through static initialization. Static
# archives are otherwise free to discard unreferenced objects, so applications
# link controller targets through this helper instead of linker-specific flags.
if(ruvia_web_FOUND)
function(ruvia_link_controllers application)
    if(NOT TARGET "${application}")
        message(FATAL_ERROR "ruvia_link_controllers requires an existing application target")
    endif()
    foreach(_ruvia_controller_target IN LISTS ARGN)
        if(NOT TARGET "${_ruvia_controller_target}")
            message(FATAL_ERROR "ruvia_link_controllers target does not exist: ${_ruvia_controller_target}")
        endif()
        get_target_property(_ruvia_controller_type "${_ruvia_controller_target}" TYPE)
        if(_ruvia_controller_type STREQUAL "STATIC_LIBRARY")
            target_link_libraries("${application}" PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${_ruvia_controller_target}>")
        elseif(_ruvia_controller_type STREQUAL "OBJECT_LIBRARY")
            target_sources("${application}" PRIVATE "$<TARGET_OBJECTS:${_ruvia_controller_target}>")
        else()
            message(FATAL_ERROR "ruvia_link_controllers accepts only STATIC_LIBRARY or OBJECT_LIBRARY targets")
        endif()
    endforeach()
endfunction()
endif()

check_required_components(ruvia)
