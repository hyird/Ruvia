cmake_minimum_required(VERSION 3.24)

set(_install_prefix "@CMAKE_BINARY_DIR@/package-consumer-install")
set(_consumer_build "@CMAKE_BINARY_DIR@/package-consumer-build")
set(_component_install_root "@CMAKE_BINARY_DIR@/package-component-installs")
set(_built_components "@RUVIA_BUILT_COMPONENTS@")
set(_built_components_csv "@RUVIA_BUILT_COMPONENTS_CSV@")

file(REMOVE_RECURSE
    "${_install_prefix}"
    "${_consumer_build}"
    "${_component_install_root}")

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --config "${RUVIA_CONFIG}" --prefix "${_install_prefix}"
    RESULT_VARIABLE _install_result)
if(NOT _install_result EQUAL 0)
    message(FATAL_ERROR "Ruvia package install failed: ${_install_result}")
endif()

if(EXISTS "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruviaTargets.cmake")
    message(FATAL_ERROR "obsolete monolithic Ruvia target export was installed")
endif()
foreach(_ruvia_component IN ITEMS core http web)
    if(_ruvia_component IN_LIST _built_components AND
       NOT EXISTS
           "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruvia-${_ruvia_component}-targets.cmake")
        message(FATAL_ERROR "component target export was not installed: ${_ruvia_component}")
    endif()
endforeach()

if(_built_components_csv MATCHES "(^|,)core(,|$)" AND
   NOT EXISTS "${_install_prefix}/include/ruvia/core/detail/Base64Url.h")
    message(FATAL_ERROR "core base64url helper was not installed")
endif()

if(_built_components_csv MATCHES "(^|,)core(,|$)")
    set(_installed_pool_waiter_path
        "${_install_prefix}/include/ruvia/core/detail/PoolWaiterQueue.h")
    if(NOT EXISTS "${_installed_pool_waiter_path}")
        message(FATAL_ERROR
            "installed core package is missing its typed pool waiter contract")
    endif()
    file(READ "${_installed_pool_waiter_path}" _installed_pool_waiter)
    if(NOT _installed_pool_waiter MATCHES
           "class PoolWaiterAcquired final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterTimedOut final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterClosed final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterResult final" OR
       NOT _installed_pool_waiter MATCHES "using Value = std::variant" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterAcquired>" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterTimedOut>" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterClosed>" OR
       NOT _installed_pool_waiter MATCHES
           "std::optional<PoolWaiterResult> result_" OR
       NOT _installed_pool_waiter MATCHES
           "bool await_ready[(][)] const noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "const PoolWaiterResult& await_resume[(][)] const noexcept" OR
       NOT _installed_pool_waiter MATCHES "void closeAll[(][)] noexcept")
        message(FATAL_ERROR
            "installed pool waiter lost its discriminated await completion")
    endif()
    if(_installed_pool_waiter MATCHES
           "bool[ \t]*&[ \t]*(ready|timedOut)" OR
       _installed_pool_waiter MATCHES
           "bool[*][ \t]*(ready_|timedOut_)" OR
       _installed_pool_waiter MATCHES "sentinelIndex" OR
       _installed_pool_waiter MATCHES "WaiterAwaiter" OR
       _installed_pool_waiter MATCHES "setHandle[ \t]*[(]" OR
       _installed_pool_waiter MATCHES
           "PoolWaiterResult[*][ \t]+result[ \t]*[(]" OR
       _installed_pool_waiter MATCHES
           "closeAll[ \t\r\n]*[(][^)]*std::size_t")
        message(FATAL_ERROR
            "installed pool waiter restored parallel completion state or a close sentinel")
    endif()
endif()

if(_built_components_csv MATCHES "(^|,)http(,|$)")
set(_installed_response_stream_commit_path
    "${_install_prefix}/include/ruvia/http/detail/server/HttpResponseStreamHead.h")
set(_installed_http1_response_stream_path
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ServerSemantics.h")
if(NOT EXISTS "${_installed_response_stream_commit_path}" OR
   NOT EXISTS "${_installed_http1_response_stream_path}")
    message(FATAL_ERROR
        "installed HTTP package is missing its response-stream commit contract")
endif()
file(READ "${_installed_response_stream_commit_path}"
    _installed_response_stream_commit)
file(READ "${_installed_http1_response_stream_path}"
    _installed_http1_response_stream)
if(NOT _installed_response_stream_commit MATCHES
       "std::uint16_t responseStatus[(][)] const noexcept" OR
   NOT _installed_response_stream_commit MATCHES
       "ResponseStreamFraming framing[(][)] const noexcept" OR
   NOT _installed_response_stream_commit MATCHES
       "HttpKnownMethod requestMethod" OR
   NOT _installed_response_stream_commit MATCHES
       "response[.]status[(][)] != commitPlan[.]responseStatus[(][)]" OR
   NOT _installed_http1_response_stream MATCHES
       "httpResponseStreamCommitPlan" OR
   NOT _installed_http1_response_stream MATCHES
       "plan[.]framing[(][)]" OR
   NOT _installed_http1_response_stream MATCHES
       "response[.]status[(][)]")
    message(FATAL_ERROR
        "installed HTTP response-stream plan lost status/framing/body coherence")
endif()
string(CONCAT _removed_response_stream_header
    "${_install_prefix}/include/ruvia/http/HttpBody" "Stream.h")
if(EXISTS "${_removed_response_stream_header}")
    message(FATAL_ERROR "removed dynamic response-body stream header was installed")
endif()
set(_removed_client_types_header
    "${_install_prefix}/include/ruvia/http/HttpClientTypes.h")
if(EXISTS "${_removed_client_types_header}")
    message(FATAL_ERROR "removed Fetch-shaped client model header was installed")
endif()
set(_installed_http_content_coding
    "${_install_prefix}/include/ruvia/http/detail/HttpContentCoding.h")
set(_removed_http_streaming_decoder
    "${_install_prefix}/include/ruvia/http/detail/client/HttpStreamingDecoder.h")
if(NOT EXISTS "${_installed_http_content_coding}")
    message(FATAL_ERROR
        "installed HTTP package is missing its typed content decoder")
endif()
if(EXISTS "${_removed_http_streaming_decoder}")
    message(FATAL_ERROR
        "removed duplicate streaming content decoder was installed")
endif()
file(READ "${_installed_http_content_coding}"
    _installed_http_content_coding_contract)
if(NOT _installed_http_content_coding_contract MATCHES
       "class HttpDecodedContent final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentDecodeFailure final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentDecodeResult final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "using Value = std::variant" OR
   NOT _installed_http_content_coding_contract MATCHES
       "decodeHttpContent" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpEncodedContent final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentEncodeFailure final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentEncodeResult final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "encodeHttpContent" OR
   _installed_http_content_coding_contract MATCHES
       "decodeRequestContentEncoding|kMaxDecodedRequestBodyBytes|bool[ \t\r\n]+encodeHttpContent|encodeHttpContent[ \t\r\n]*[(][^)]*std::pmr::string[ \t]*&")
    message(FATAL_ERROR
        "installed HTTP content coding lost its owning discriminated contract")
endif()
set(_installed_url_encoding
    "${_install_prefix}/include/ruvia/http/UrlEncoding.h")
if(NOT EXISTS "${_installed_url_encoding}")
    message(FATAL_ERROR
        "installed HTTP package is missing URL decoding")
endif()
file(READ "${_installed_url_encoding}"
    _installed_url_encoding_contract)
if(NOT _installed_url_encoding_contract MATCHES
       "std::optional<std::pmr::string>[ \t\r\n]+decodeUrlComponent" OR
   _installed_url_encoding_contract MATCHES
       "decodeUrlComponentToString|decodeFormComponent|StringT[ \t]*&[ \t]*output")
    message(FATAL_ERROR
        "installed URL decoder lost its owning transactional contract")
endif()
set(_removed_loose_http_parser_header
    "${_install_prefix}/include/ruvia/http/HttpParser.h")
if(EXISTS "${_removed_loose_http_parser_header}")
    message(FATAL_ERROR "removed loose HTTP parser result header was installed")
endif()
set(_removed_http_parse_status_header
    "${_install_prefix}/include/ruvia/http/HttpParseTypes.h")
if(EXISTS "${_removed_http_parse_status_header}")
    message(FATAL_ERROR "removed loose HTTP parse-status header was installed")
endif()
set(_removed_generic_server_parser_header
    "${_install_prefix}/include/ruvia/http/detail/HttpParserInternal.h")
if(EXISTS "${_removed_generic_server_parser_header}")
    message(FATAL_ERROR "removed generic internal HTTP parser header was installed")
endif()
if(NOT EXISTS "${_install_prefix}/include/ruvia/http/HttpParseError.h")
    message(FATAL_ERROR "typed HTTP parse-error header was not installed")
endif()
set(_removed_generic_chunk_framer
    "${_install_prefix}/include/ruvia/http/detail/HttpBodyFramer.h")
if(EXISTS "${_removed_generic_chunk_framer}")
    message(FATAL_ERROR "removed generic HTTP body framer was installed")
endif()
set(_installed_http1_chunk_decoder
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ChunkedBodyDecoder.h")
set(_installed_http1_chunk_scanner
    "${_install_prefix}/include/ruvia/http/detail/parser/HttpChunkParser.h")
if(NOT EXISTS "${_installed_http1_chunk_decoder}" OR
   NOT EXISTS "${_installed_http1_chunk_scanner}")
    message(FATAL_ERROR "installed HTTP target is missing its typed HTTP/1 chunked contracts")
endif()
file(READ "${_installed_http1_chunk_decoder}"
    _installed_http1_chunk_decoder_content)
file(READ "${_installed_http1_chunk_scanner}"
    _installed_http1_chunk_scanner_content)
if(NOT _installed_http1_chunk_decoder_content MATCHES
       "class Http1ChunkedBodyDecoder final" OR
   NOT _installed_http1_chunk_decoder_content MATCHES
       "class Http1ChunkDecodeNeedMore final" OR
   NOT _installed_http1_chunk_decoder_content MATCHES
       "class Http1ChunkDecodeBodyChunk final" OR
   NOT _installed_http1_chunk_decoder_content MATCHES
       "class Http1ChunkDecodeComplete final" OR
   NOT _installed_http1_chunk_decoder_content MATCHES
       "using Value = std::variant" OR
   NOT _installed_http1_chunk_decoder_content MATCHES
       "std::size_t consumedBytes[(][)] const" OR
   NOT _installed_http1_chunk_decoder_content MATCHES
       "std::string_view bytes[(][)] const" OR
   NOT _installed_http1_chunk_decoder_content MATCHES
       "std::get_if<Http1ChunkDecodeBodyChunk>")
    message(FATAL_ERROR "installed HTTP/1 streaming chunk decoder lost its discriminated result contract")
endif()
if(NOT _installed_http1_chunk_scanner_content MATCHES
       "class HttpChunkScanNeedMore final" OR
   NOT _installed_http1_chunk_scanner_content MATCHES
       "class HttpChunkScanComplete final" OR
   NOT _installed_http1_chunk_scanner_content MATCHES
       "class HttpChunkScanFailure final" OR
   NOT _installed_http1_chunk_scanner_content MATCHES
       "class HttpChunkScanResult final" OR
   NOT _installed_http1_chunk_scanner_content MATCHES
       "using Value = std::variant" OR
   NOT _installed_http1_chunk_scanner_content MATCHES
       "std::optional<HttpChunkScanError> validateHttpChunkTrailers")
    message(FATAL_ERROR "installed HTTP/1 whole-message chunk scanner lost its discriminated result contract")
endif()
if(_installed_http1_chunk_decoder_content MATCHES
       "HttpChunkDecodeEvent|HttpChunkDecodeEventKind" OR
   _installed_http1_chunk_scanner_content MATCHES
       "struct[ \t]+HttpChunkScanResult|HttpChunkScanStatus")
    message(FATAL_ERROR "installed HTTP/1 chunked API restored a loose event/status tuple")
endif()
foreach(_removed_http1_client_response_header IN ITEMS
    "${_install_prefix}/include/ruvia/http/detail/client/HttpClientResponseParser.h"
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ClientResponsePlan.h")
    if(EXISTS "${_removed_http1_client_response_header}")
        message(FATAL_ERROR "removed private HTTP/1 client response parser header was installed")
    endif()
endforeach()
set(_installed_http1_client_response_parser
    "${_install_prefix}/include/ruvia/http/Http1ClientResponseParser.h")
if(NOT EXISTS "${_installed_http1_client_response_parser}")
    message(FATAL_ERROR "public HTTP/1 client response parser was not installed")
endif()
file(READ "${_installed_http1_client_response_parser}"
    _installed_http1_client_response_parser_content)
if(_installed_http1_client_response_parser_content MATCHES
       "Http1ClientResponseBodyMode|Http1ClientConnectionDisposition|connectionDisposition[(][)]|isCloseDelimited[(][)]|isOpaque[(][)]")
    message(FATAL_ERROR "installed HTTP/1 client response parser restored a mode/payload lifecycle tuple")
endif()
if(NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientResponseParser final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientInformationalResponse final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientResponseWithoutContent final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientKnownLengthResponse final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientChunkedResponse final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientCloseDelimitedResponse final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientConnectTunnel final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientProtocolUpgrade final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "Http1ClientResponsePersistence" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "informational[(][)]" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "withoutContent[(][)]" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "knownLength[(][)]" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "chunked[(][)]" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "closeDelimited[(][)]" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "connectTunnel[(][)]" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "protocolUpgrade[(][)]" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientResponseNeedMore final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ParsedClientResponseHead final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientResponseParseFailure final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "class Http1ClientResponseParseResult final" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "const PreparedHttp1ClientRequest& request" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "Http1ClientRequestContentSignal" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "requestContentSignal" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "Http1ClientRequestContentCompletionStatus" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "completeRequestContent" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "kExchangeComplete" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "kExchangeFailed" OR
   NOT _installed_http1_client_response_parser_content MATCHES
       "consumedBytes")
    message(FATAL_ERROR "installed HTTP/1 client response parser lost its discriminated public contract")
endif()
set(_installed_http1_client_request_writer
    "${_install_prefix}/include/ruvia/http/Http1ClientRequestWriter.h")
if(NOT EXISTS "${_installed_http1_client_request_writer}")
    message(FATAL_ERROR "public HTTP/1 client request writer was not installed")
endif()
file(READ "${_installed_http1_client_request_writer}"
    _installed_http1_client_request_writer_content)
if(NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestWriter final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class PreparedHttp1ClientRequest final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestBufferTooSmall final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestPrepareFailure final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestPrepareResult final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "prepareConnect" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestWirePolicy final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestContentPlan final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestWithoutContent final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientImmediateRequestContent final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientContinueGatedRequestContent final" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "using Content = std::variant" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "std::get_if<Http1ClientRequestWithoutContent>" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "std::get_if<Http1ClientImmediateRequestContent>" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "std::get_if<Http1ClientContinueGatedRequestContent>" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "kExpectHeaderManagedByWriter" OR
   NOT _installed_http1_client_request_writer_content MATCHES
       "std::span<char> headBuffer")
    message(FATAL_ERROR "installed HTTP/1 client request writer lost its transactional public contract")
endif()
if(_installed_http1_client_request_writer_content MATCHES
       "Http1ClientRequestContentDisposition" OR
   _installed_http1_client_request_writer_content MATCHES "expectsContinue" OR
   _installed_http1_client_request_writer_content MATCHES
       "disposition[(][)] const noexcept" OR
   _installed_http1_client_request_writer_content MATCHES
       "class Http1ClientRequestContentPlan[^}]*bytes[(][)]")
    message(FATAL_ERROR "installed HTTP/1 client request writer retained a mode/payload content tuple")
endif()
if(_installed_http1_client_request_writer_content MATCHES
   "responseContext[ \\t\\r\\n]*\\([ \\t\\r\\n]*\\)")
    message(FATAL_ERROR "installed HTTP/1 request plan still leaks a reconstructible response context")
endif()
foreach(_removed_http2_upgrade_header IN ITEMS
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2Upgrade.h"
    "${_install_prefix}/include/ruvia/web/detail/http2/Http2UpgradeHandshake.h"
    "${_install_prefix}/include/ruvia/web/detail/server/HttpServerHttp2UpgradeRoute.h")
    if(EXISTS "${_removed_http2_upgrade_header}")
        message(FATAL_ERROR "obsolete HTTP/2 HTTP/1.1 Upgrade header was installed")
    endif()
endforeach()
if(EXISTS "${_install_prefix}/include/ruvia/http/detail/HttpBase64Url.h")
    message(FATAL_ERROR "generic base64url helper was installed under the HTTP target")
endif()
set(_installed_http_byte_range_path
    "${_install_prefix}/include/ruvia/http/detail/HttpByteRange.h")
if(NOT EXISTS "${_installed_http_byte_range_path}")
    message(FATAL_ERROR "installed HTTP package is missing its byte-range resolution contract")
endif()
file(READ "${_installed_http_byte_range_path}" _installed_http_byte_range)
if(_installed_http_byte_range MATCHES "HttpRangeOutcome" OR
   _installed_http_byte_range MATCHES "HttpByteRangeResult" OR
   _installed_http_byte_range MATCHES "struct[ \t]+HttpByteRange" OR
   _installed_http_byte_range MATCHES "httpParseByteRange" OR
   _installed_http_byte_range MATCHES "httpByteRangeSetHasMultiple")
    message(FATAL_ERROR "installed HTTP byte-range helper restored a loose or split result API")
endif()
if(NOT _installed_http_byte_range MATCHES
       "class HttpByteRangeIgnored final" OR
   NOT _installed_http_byte_range MATCHES
       "class HttpByteRangeUnsatisfiable final" OR
   NOT _installed_http_byte_range MATCHES
       "class HttpResolvedByteRange final" OR
   NOT _installed_http_byte_range MATCHES
       "class HttpByteRangeResolution final" OR
   NOT _installed_http_byte_range MATCHES "using Value = std::variant" OR
   NOT _installed_http_byte_range MATCHES
       "std::get_if<HttpByteRangeIgnored>" OR
   NOT _installed_http_byte_range MATCHES
       "std::get_if<HttpByteRangeUnsatisfiable>" OR
   NOT _installed_http_byte_range MATCHES
       "std::get_if<HttpResolvedByteRange>" OR
   NOT _installed_http_byte_range MATCHES "resolveHttpByteRange" OR
   NOT _installed_http_byte_range MATCHES "httpAsciiEqualsIgnoreCase" OR
   NOT _installed_http_byte_range MATCHES "std::errc::result_out_of_range" OR
   NOT _installed_http_byte_range MATCHES "representationLength == 0")
    message(FATAL_ERROR "installed HTTP byte-range helper lost its discriminated RFC resolution")
endif()
file(READ "${_install_prefix}/include/ruvia/http/detail/http2/Http2Connection.h"
    _installed_http2_connection)
set(_installed_http2_peer_settings_path
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2PeerSettings.h")
if(NOT EXISTS "${_installed_http2_peer_settings_path}")
    message(FATAL_ERROR "installed HTTP/2 core is missing its peer SETTINGS contract")
endif()
file(READ "${_installed_http2_peer_settings_path}" _installed_http2_peer_settings)
if(_installed_http2_peer_settings MATCHES "Http2PeerSettingsStatus" OR
   _installed_http2_peer_settings MATCHES "Http2PeerSettingsResult" OR
   _installed_http2_peer_settings MATCHES "initialWindowChanged" OR
   _installed_http2_peer_settings MATCHES "initialWindowDelta" OR
   _installed_http2_peer_settings MATCHES "http2PeerSettingsError")
    message(FATAL_ERROR "installed HTTP/2 peer SETTINGS restored the status/changed/delta tuple")
endif()
if(NOT _installed_http2_peer_settings MATCHES
       "enum class Http2PeerSettingError" OR
   NOT _installed_http2_peer_settings MATCHES
       "class Http2PeerSettingApplied final" OR
   NOT _installed_http2_peer_settings MATCHES
       "class Http2PeerInitialWindowChange final" OR
   NOT _installed_http2_peer_settings MATCHES
       "class Http2PeerSettingFailure final" OR
   NOT _installed_http2_peer_settings MATCHES
       "class Http2PeerSettingApplyResult final" OR
   NOT _installed_http2_peer_settings MATCHES "using Value = std::variant" OR
   NOT _installed_http2_peer_settings MATCHES
       "std::get_if<Http2PeerSettingApplied>" OR
   NOT _installed_http2_peer_settings MATCHES
       "std::get_if<Http2PeerInitialWindowChange>" OR
   NOT _installed_http2_peer_settings MATCHES
       "std::get_if<Http2PeerSettingFailure>" OR
   NOT _installed_http2_peer_settings MATCHES "makeInitialWindowChange" OR
   NOT _installed_http2_peer_settings MATCHES "http2PeerSettingErrorCode")
    message(FATAL_ERROR "installed HTTP/2 peer SETTINGS lost its discriminated apply result")
endif()
if(_installed_http2_connection MATCHES
   "beginUpgraded|seedUpgradedStream|HTTP2-Settings")
    message(FATAL_ERROR "installed HTTP/2 core still exposes obsolete HTTP/1.1 Upgrade state")
endif()
if(_installed_http2_connection MATCHES "Http2FeedStatus" OR
   _installed_http2_connection MATCHES "struct[ \t]+Http2FeedResult")
    message(FATAL_ERROR "installed HTTP/2 core restored the feed status/byte-count tuple")
endif()
if(NOT _installed_http2_connection MATCHES "enum class Http2FeedResult" OR
   NOT _installed_http2_connection MATCHES "kConnectionNotStarted" OR
   NOT _installed_http2_connection MATCHES "kEventsPending" OR
   NOT _installed_http2_connection MATCHES "kAccepted" OR
   NOT _installed_http2_connection MATCHES "kNeedInput" OR
   NOT _installed_http2_connection MATCHES "kProtocolFailure")
    message(FATAL_ERROR "installed HTTP/2 core lost its direct feed ownership result")
endif()
if(NOT _installed_http2_connection MATCHES "releaseReceivedData" OR
   _installed_http2_connection MATCHES "deferStreamWindowRelease" OR
   _installed_http2_connection MATCHES "releaseStreamWindow" OR
   _installed_http2_connection MATCHES "Http2ConnectionLimits")
    message(FATAL_ERROR
        "installed HTTP/2 core retained Web body policy or implicit DATA credit release")
endif()
if(_installed_http2_connection MATCHES "Http2RequestHeadSubmitStatus" OR
   _installed_http2_connection MATCHES
       "status_[ \t]*;[ \t\r\n]*std::uint32_t[ \t]+streamId_")
    message(FATAL_ERROR "installed HTTP/2 core restored the request-head status/stream-ID tuple")
endif()
if(NOT _installed_http2_connection MATCHES
