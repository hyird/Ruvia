function(ruvia_verify_package_consumer
    name prefix components visible_components available_components optional_components
    expect_configure_failure)
    set(_build_dir "${_consumer_build}/${name}")
    file(REMOVE_RECURSE "${_build_dir}")

    set(_configure_command
        "@CMAKE_COMMAND@"
        -S "@CMAKE_SOURCE_DIR@/tests/package-consumer"
        -B "${_build_dir}"
        -G "@CMAKE_GENERATOR@"
        "-DCMAKE_PREFIX_PATH=${prefix}"
        "-DCMAKE_CONFIGURATION_TYPES=${RUVIA_CONFIG}"
        "-DRUVIA_PACKAGE_COMPONENTS=${components}"
        "-DRUVIA_PACKAGE_OPTIONAL_COMPONENTS=${optional_components}"
        "-DRUVIA_EXPECT_VISIBLE_COMPONENTS=${visible_components}"
        "-DRUVIA_EXPECT_AVAILABLE_COMPONENTS=${available_components}")

    if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
        list(APPEND _configure_command -A "@CMAKE_GENERATOR_PLATFORM@")
    endif()
    if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
        list(APPEND _configure_command -T "@CMAKE_GENERATOR_TOOLSET@")
    endif()
    if(NOT _ruvia_toolchain_file STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_TOOLCHAIN_FILE=${_ruvia_toolchain_file}")
    endif()
    if(NOT "@VCPKG_TARGET_TRIPLET@" STREQUAL "")
        list(APPEND _configure_command "-DVCPKG_TARGET_TRIPLET=@VCPKG_TARGET_TRIPLET@")
    endif()
    if(NOT "@VCPKG_INSTALLED_DIR@" STREQUAL "")
        list(APPEND _configure_command "-DVCPKG_INSTALLED_DIR=@VCPKG_INSTALLED_DIR@")
    endif()
    if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@")
    endif()
    if(NOT "@CMAKE_CXX_FLAGS@" STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@")
    endif()
    if(NOT "@CMAKE_EXE_LINKER_FLAGS@" STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@")
    endif()

    execute_process(COMMAND ${_configure_command} RESULT_VARIABLE _configure_result)
    if(expect_configure_failure)
        if(_configure_result EQUAL 0)
            message(FATAL_ERROR
                "Ruvia package consumer '${name}' unexpectedly accepted a missing required component")
        endif()
        return()
    endif()
    if(NOT _configure_result EQUAL 0)
        message(FATAL_ERROR
            "Ruvia package consumer '${name}' configure failed: ${_configure_result}")
    endif()

    execute_process(
        COMMAND "@CMAKE_COMMAND@" --build "${_build_dir}"
            --config "${RUVIA_CONFIG}" --parallel
        RESULT_VARIABLE _build_result)
    if(NOT _build_result EQUAL 0)
        message(FATAL_ERROR
            "Ruvia package consumer '${name}' build failed: ${_build_result}")
    endif()
endfunction()

function(ruvia_install_component_package name components_csv)
    set(_prefix "${_component_install_root}/${name}")
    string(REPLACE "," ";" _components "${components_csv}")
    foreach(_component IN LISTS _components)
        execute_process(
            COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@"
                --config "${RUVIA_CONFIG}"
                --prefix "${_prefix}"
                --component "${_component}"
            RESULT_VARIABLE _component_install_result)
        if(NOT _component_install_result EQUAL 0)
            message(FATAL_ERROR
                "Ruvia '${name}' component install failed for ${_component}: ${_component_install_result}")
        endif()
    endforeach()
    execute_process(
        COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@"
            --config "${RUVIA_CONFIG}"
            --prefix "${_prefix}"
            --component Development
        RESULT_VARIABLE _development_install_result)
    if(NOT _development_install_result EQUAL 0)
        message(FATAL_ERROR
            "Ruvia '${name}' Development install failed: ${_development_install_result}")
    endif()

    foreach(_component IN ITEMS core http web)
        set(_export
            "${_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruvia-${_component}-targets.cmake")
        if(_component IN_LIST _components)
            if(NOT EXISTS "${_export}")
                message(FATAL_ERROR
                    "Ruvia '${name}' install omitted the ${_component} target export")
            endif()
        elseif(EXISTS "${_export}")
            message(FATAL_ERROR
                "Ruvia '${name}' install leaked the ${_component} target export")
        endif()
    endforeach()

    set(${name}_PREFIX "${_prefix}" PARENT_SCOPE)
endfunction()

# A full install exposes every available component but imports only the requested
# target closure into each consuming project.
ruvia_verify_package_consumer(
    full-all "${_install_prefix}" "${_built_components_csv}"
    "${_built_components_csv}" "${_built_components_csv}" "" FALSE)

if("web" IN_LIST _built_components)
    set(_send_window_header
        "${_install_prefix}/include/ruvia/web/detail/http2/Http2SansIoSendWindow.h")
    set(_ws_transport_read_header
        "${_install_prefix}/include/ruvia/web/detail/websocket/WsTransportReadResult.h")
    set(_app_lifecycle_header
        "${_install_prefix}/include/ruvia/web/detail/app/AppLifecycle.h")
    set(_http2_session_lifecycle_header
        "${_install_prefix}/include/ruvia/web/detail/server/Http2SansIoSessionLifecycle.h")
    if(NOT EXISTS "${_send_window_header}")
        message(FATAL_ERROR
            "installed web package is missing Http2SansIoSendWindow.h")
    endif()
    file(READ "${_send_window_header}" _send_window_header_content)
    if(NOT _send_window_header_content MATCHES
           "class Http2SendWindowWaitResult final" OR
       NOT _send_window_header_content MATCHES
           "Task<Http2SendWindowWaitResult> awaitHttp2SendWindow" OR
       NOT _send_window_header_content MATCHES
           "const Http2SendWindowReady[*] ready[(][)] const &" OR
       NOT _send_window_header_content MATCHES
           "const Http2SendWindowAborted[*] aborted[(][)] const &")
        message(FATAL_ERROR
            "installed HTTP/2 send-window wait contract is incomplete")
    endif()
    if(NOT EXISTS "${_ws_transport_read_header}")
        message(FATAL_ERROR
            "installed web package is missing WsTransportReadResult.h")
    endif()
    if(NOT EXISTS "${_app_lifecycle_header}")
        message(FATAL_ERROR
            "installed web package is missing AppLifecycle.h")
    endif()
    if(NOT EXISTS "${_http2_session_lifecycle_header}")
        message(FATAL_ERROR
            "installed web package is missing Http2SansIoSessionLifecycle.h")
    endif()
    file(READ "${_http2_session_lifecycle_header}"
        _http2_session_lifecycle_content)
    if(NOT _http2_session_lifecycle_content MATCHES
           "enum class Http2SansIoSessionPhase" OR
       NOT _http2_session_lifecycle_content MATCHES
           "class Http2SansIoSessionLifecycle final" OR
       NOT _http2_session_lifecycle_content MATCHES
           "kWriterDoneAfterWriteFailure")
        message(FATAL_ERROR
            "installed HTTP/2 Web session lifecycle contract is incomplete")
    endif()
    file(READ "${_app_lifecycle_header}" _app_lifecycle_content)
    if(NOT _app_lifecycle_content MATCHES "enum class AppLifecycleState" OR
       NOT _app_lifecycle_content MATCHES "enum class AppStopRequest" OR
       NOT _app_lifecycle_content MATCHES "class AppLifecycle final")
        message(FATAL_ERROR
            "installed App lifecycle state contract is incomplete")
    endif()
    file(READ "${_ws_transport_read_header}" _ws_transport_read_content)
    if(NOT _ws_transport_read_content MATCHES
           "class WsTransportReadResult final" OR
       NOT _ws_transport_read_content MATCHES
           "class WsTransportReadFailure final" OR
       NOT _ws_transport_read_content MATCHES
           "std::error_code errorCode[(][)] const noexcept")
        message(FATAL_ERROR
            "installed WebSocket transport read contract is incomplete")
    endif()
endif()

if("core" IN_LIST _built_components)
    ruvia_verify_package_consumer(
        full-core "${_install_prefix}" core core "${_built_components_csv}"
        unavailable FALSE)

    ruvia_install_component_package(partial_core core)
    ruvia_verify_package_consumer(
        partial-core "${partial_core_PREFIX}" core core core unavailable FALSE)
    ruvia_verify_package_consumer(
        partial-core-missing-web "${partial_core_PREFIX}" web "" core "" TRUE)
endif()

if("http" IN_LIST _built_components)
    set(_installed_http_borrowed_view
        "${_install_prefix}/include/ruvia/http/detail/BorrowedView.h")
    if(NOT EXISTS "${_installed_http_borrowed_view}")
        message(FATAL_ERROR
            "installed HTTP package is missing the borrowed-view lifetime contract")
    endif()
    file(READ "${_installed_http_borrowed_view}"
        _installed_http_borrowed_view_content)
    if(NOT _installed_http_borrowed_view_content MATCHES
           "kIsHttpOwningCharString" OR
       NOT _installed_http_borrowed_view_content MATCHES
           "HttpTemporaryOwningCharString")
        message(FATAL_ERROR
            "installed HTTP borrowed-view lifetime contract is incomplete")
    endif()

    ruvia_verify_package_consumer(
        full-http "${_install_prefix}" http http "${_built_components_csv}"
        unavailable FALSE)

    ruvia_install_component_package(partial_http http)
    ruvia_verify_package_consumer(
        partial-http "${partial_http_PREFIX}" http http http unavailable FALSE)
    ruvia_verify_package_consumer(
        partial-http-missing-core "${partial_http_PREFIX}" core "" http "" TRUE)
endif()

if("web" IN_LIST _built_components)
    set(_installed_context_session_state
        "${_install_prefix}/include/ruvia/web/detail/http/ContextSessionState.h")
    set(_installed_secure_token_result
        "${_install_prefix}/include/ruvia/web/detail/http/CsrfInternal.h")
    set(_installed_http1_closing_rejection
        "${_install_prefix}/include/ruvia/web/detail/server/Http1ClosingRejection.h")
    set(_installed_request_body_facade
        "${_install_prefix}/include/ruvia/web/detail/body/HttpRequestBodyFacade.h")
    set(_installed_request_body_loader
        "${_install_prefix}/include/ruvia/web/detail/http/RequestBodyLoader.h")
    set(_installed_lazy_buffered_body
        "${_install_prefix}/include/ruvia/web/detail/body/HttpLazyBufferedBody.h")
    set(_installed_streaming_facade
        "${_install_prefix}/include/ruvia/web/Streaming.h")
    set(_installed_stream_body_reader
        "${_install_prefix}/include/ruvia/web/detail/body/HttpStreamBodyReader.h")
    if(NOT EXISTS "${_installed_context_session_state}" OR
       NOT EXISTS "${_installed_secure_token_result}" OR
       NOT EXISTS "${_installed_http1_closing_rejection}" OR
       NOT EXISTS "${_installed_request_body_facade}" OR
       NOT EXISTS "${_installed_request_body_loader}" OR
       NOT EXISTS "${_installed_lazy_buffered_body}" OR
       NOT EXISTS "${_installed_streaming_facade}" OR
       NOT EXISTS "${_installed_stream_body_reader}")
        message(FATAL_ERROR
            "installed Web package is missing typed session/token contracts")
    endif()
    file(READ "${_installed_context_session_state}"
        _installed_context_session_state_content)
    file(READ "${_installed_secure_token_result}"
        _installed_secure_token_result_content)
    file(READ "${_installed_http1_closing_rejection}"
        _installed_http1_closing_rejection_content)
    file(READ "${_installed_request_body_facade}"
        _installed_request_body_facade_content)
    file(READ "${_installed_request_body_loader}"
        _installed_request_body_loader_content)
    file(READ "${_installed_lazy_buffered_body}"
        _installed_lazy_buffered_body_content)
    file(READ "${_installed_streaming_facade}"
        _installed_streaming_facade_content)
    file(READ "${_installed_stream_body_reader}"
        _installed_stream_body_reader_content)
    if(NOT _installed_context_session_state_content MATCHES
           "class ContextSessionState final" OR
       NOT _installed_context_session_state_content MATCHES
           "SessionClear" OR
       NOT _installed_secure_token_result_content MATCHES
           "class SecureTokenResult final" OR
       _installed_secure_token_result_content MATCHES
           "generateCsrfToken" OR
       NOT _installed_http1_closing_rejection_content MATCHES
           "class Http1ClosingRejection final" OR
       NOT _installed_http1_closing_rejection_content MATCHES
           "Http1ClosingRateLimitRejection" OR
       NOT _installed_request_body_facade_content MATCHES
           "class BodyReaderBinding final" OR
       NOT _installed_request_body_facade_content MATCHES
           "class RequestBodyLoaderBinding final")
        message(FATAL_ERROR
            "installed Web session/token contracts are stale")
    endif()
    if(NOT _installed_request_body_loader_content MATCHES "kReading" OR
       NOT _installed_request_body_loader_content MATCHES "kDiscarding" OR
       NOT _installed_request_body_loader_content MATCHES "kDiscarded" OR
       NOT _installed_request_body_loader_content MATCHES "kFailed" OR
       NOT _installed_request_body_loader_content MATCHES "class OperationGuard final" OR
       NOT _installed_request_body_loader_content MATCHES "state_ = State::kFailed" OR
       _installed_lazy_buffered_body_content MATCHES "bool[ 	]+read_|bodyView_")
        message(FATAL_ERROR
            "installed lazy request-body consumer lost its exclusive lifecycle")
    endif()
    if(NOT _installed_streaming_facade_content MATCHES
           "bool[ \t]+readActive_" OR
       NOT _installed_streaming_facade_content MATCHES
           "Only one read may be in flight")
        message(FATAL_ERROR
            "installed BodyReader lost its single-consumer borrowed-buffer contract")
    endif()
    if(NOT _installed_stream_body_reader_content MATCHES
           "PmrObjectDeleter<TransferCodingDecoder>>[ \t]+transferDecoder_" OR
       _installed_stream_body_reader_content MATCHES
           "TransferCodingDecoder[*][ \t]+transferDecoder_|transferDecoderAllocator_")
        message(FATAL_ERROR
            "installed H1 stream body reader restored split decoder ownership")
    endif()

    ruvia_verify_package_consumer(
        full-web "${_install_prefix}" web "core,http,web"
        "${_built_components_csv}" unavailable FALSE)

    # A web artifact without both lower target exports is deliberately not a
    # usable package component; install the full closure for the success case.
    ruvia_install_component_package(partial_web_only web)
    ruvia_verify_package_consumer(
        partial-web-missing-dependencies "${partial_web_only_PREFIX}"
        web "" "" "" TRUE)

    ruvia_install_component_package(partial_web_closure "core,http,web")
    ruvia_verify_package_consumer(
        partial-web-closure "${partial_web_closure_PREFIX}" web "core,http,web"
        "core,http,web" unavailable FALSE)
endif()
