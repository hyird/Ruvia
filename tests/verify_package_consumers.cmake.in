cmake_minimum_required(VERSION 3.24)

set(_install_prefix "@CMAKE_BINARY_DIR@/package-consumer-install")
set(_consumer_build "@CMAKE_BINARY_DIR@/package-consumer-build")
set(_component_install_root "@CMAKE_BINARY_DIR@/package-component-installs")
set(_built_components "@RUVIA_BUILT_COMPONENTS@")
set(_built_components_csv "@RUVIA_BUILT_COMPONENTS_CSV@")

file(REMOVE_RECURSE
    "${_install_prefix}"
    "${_consumer_build}"
    "${_component_install_root}")

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --config "${RUVIA_CONFIG}" --prefix "${_install_prefix}"
    RESULT_VARIABLE _install_result)
if(NOT _install_result EQUAL 0)
    message(FATAL_ERROR "Ruvia package install failed: ${_install_result}")
endif()

if(EXISTS "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruviaTargets.cmake")
    message(FATAL_ERROR "obsolete monolithic Ruvia target export was installed")
endif()
foreach(_ruvia_component IN ITEMS core http web)
    if(_ruvia_component IN_LIST _built_components AND
       NOT EXISTS
           "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruvia-${_ruvia_component}-targets.cmake")
        message(FATAL_ERROR "component target export was not installed: ${_ruvia_component}")
    endif()
endforeach()

if(_built_components_csv MATCHES "(^|,)core(,|$)" AND
   NOT EXISTS "${_install_prefix}/include/ruvia/core/detail/Base64Url.h")
    message(FATAL_ERROR "core base64url helper was not installed")
endif()

if(_built_components_csv MATCHES "(^|,)core(,|$)")
    set(_installed_operation_deadline_path
        "${_install_prefix}/include/ruvia/core/detail/OperationDeadline.h")
    if(NOT EXISTS "${_installed_operation_deadline_path}")
        message(FATAL_ERROR
            "installed core package is missing OperationDeadline")
    endif()
    file(READ "${_installed_operation_deadline_path}"
        _installed_operation_deadline)
    if(NOT _installed_operation_deadline MATCHES
           "struct Inactive final" OR
       NOT _installed_operation_deadline MATCHES
           "struct Active final" OR
       NOT _installed_operation_deadline MATCHES
           "struct Expired final" OR
       NOT _installed_operation_deadline MATCHES
           "using State = std::variant" OR
       NOT _installed_operation_deadline MATCHES
           "requires std::is_enum_v<Kind>" OR
       _installed_operation_deadline MATCHES
           "bool active_|bool expired_|optional<Kind> kind_")
        message(FATAL_ERROR
            "installed OperationDeadline restored parallel lifecycle state")
    endif()

    set(_installed_task_scope_path
        "${_install_prefix}/include/ruvia/core/TaskScope.h")
    if(NOT EXISTS "${_installed_task_scope_path}")
        message(FATAL_ERROR
            "installed core package is missing TaskScope")
    endif()
    file(READ "${_installed_task_scope_path}"
        _installed_task_scope)
    if(NOT _installed_task_scope MATCHES
           "struct TaskScopeEmpty final" OR
       NOT _installed_task_scope MATCHES
           "struct TaskScopeOpen final" OR
       NOT _installed_task_scope MATCHES
           "class TaskScopeJoining final" OR
       NOT _installed_task_scope MATCHES
           "struct TaskScopeJoined final" OR
       NOT _installed_task_scope MATCHES
           "struct TaskScopeSuccess final" OR
       NOT _installed_task_scope MATCHES
           "class TaskScopeFailure final" OR
       NOT _installed_task_scope MATCHES
           "using Lifecycle = std::variant" OR
       NOT _installed_task_scope MATCHES
           "using Outcome = std::variant" OR
       _installed_task_scope MATCHES
           "firstFailure_|joinContinuation_|joinStarted_")
        message(FATAL_ERROR
            "installed TaskScope restored overlapping join/failure state")
    endif()

    set(_installed_channel_path
        "${_install_prefix}/include/ruvia/core/Channel.h")
    if(NOT EXISTS "${_installed_channel_path}")
        message(FATAL_ERROR
            "installed core package is missing Channel")
    endif()
    file(READ "${_installed_channel_path}"
        _installed_channel)
    if(NOT _installed_channel MATCHES
           "struct ChannelOpen final" OR
       NOT _installed_channel MATCHES
           "struct ChannelClosed final" OR
       NOT _installed_channel MATCHES
           "struct ChannelWorkerStopping final" OR
       NOT _installed_channel MATCHES
           "using Lifecycle = std::variant" OR
       NOT _installed_channel MATCHES
           "emplace<ChannelWorkerStopping>" OR
       NOT _installed_channel MATCHES
           "emplace<detail::ChannelClosed>" OR
       _installed_channel MATCHES
           "bool closed|bool workerStopped")
        message(FATAL_ERROR
            "installed Channel restored overlapping lifecycle flags")
    endif()

    set(_installed_one_shot_path
        "${_install_prefix}/include/ruvia/core/OneShot.h")
    if(NOT EXISTS "${_installed_one_shot_path}")
        message(FATAL_ERROR
            "installed core package is missing OneShot")
    endif()
    file(READ "${_installed_one_shot_path}"
        _installed_one_shot)
    if(NOT _installed_one_shot MATCHES
           "struct OneShotPending final" OR
       NOT _installed_one_shot MATCHES
           "class OneShotReady final" OR
       NOT _installed_one_shot MATCHES
           "struct OneShotConsumed final" OR
       NOT _installed_one_shot MATCHES
           "struct OneShotReceiverClosed final" OR
       NOT _installed_one_shot MATCHES
           "struct OneShotWorkerStopping final" OR
       NOT _installed_one_shot MATCHES
           "using Lifecycle = std::variant" OR
       NOT _installed_one_shot MATCHES
           "wakeOneShotReceiver" OR
       _installed_one_shot MATCHES
           "std::optional<T>[ \t]+value|bool completed|bool consumed|bool closed|bool workerStopped")
        message(FATAL_ERROR
            "installed OneShot restored parallel lifecycle flags")
    endif()

    set(_installed_worker_wait_awaiter_path
        "${_install_prefix}/include/ruvia/core/detail/WorkerWaitAwaiter.h")
    set(_installed_worker_timer_path
        "${_install_prefix}/include/ruvia/core/detail/WorkerTimer.h")
    set(_installed_worker_handle_path
        "${_install_prefix}/include/ruvia/core/WorkerHandle.h")
    set(_installed_event_loop_pool_path
        "${_install_prefix}/include/ruvia/core/EventLoopPool.h")
    set(_installed_worker_dispatcher_path
        "${_install_prefix}/include/ruvia/core/detail/WorkerDispatcher.h")
    set(_installed_worker_signal_path
        "${_install_prefix}/include/ruvia/core/detail/WorkerSignal.h")
    if(NOT EXISTS "${_installed_worker_wait_awaiter_path}" OR
       NOT EXISTS "${_installed_worker_timer_path}" OR
       NOT EXISTS "${_installed_worker_handle_path}" OR
       NOT EXISTS "${_installed_event_loop_pool_path}" OR
       NOT EXISTS "${_installed_worker_dispatcher_path}" OR
       NOT EXISTS "${_installed_worker_signal_path}")
        message(FATAL_ERROR
            "installed core package is missing event-loop/worker contracts")
    endif()
    file(READ "${_installed_worker_wait_awaiter_path}"
        _installed_worker_wait_awaiter)
    file(READ "${_installed_worker_timer_path}"
        _installed_worker_timer)
    file(READ "${_installed_worker_handle_path}"
        _installed_worker_handle)
    file(READ "${_installed_worker_dispatcher_path}"
        _installed_worker_dispatcher)
    file(READ "${_installed_worker_signal_path}"
        _installed_worker_signal)
    if(NOT _installed_worker_signal MATCHES
           "const WorkerHandle[*][ \\t]+worker_" OR
       NOT _installed_worker_signal MATCHES
           "Awaiter[*][ \\t]+waiters_" OR
       NOT _installed_worker_signal MATCHES
           "std::size_t scheduledWaiters_" OR
       NOT _installed_worker_signal MATCHES
           "~Awaiter[(][)]" OR
       NOT _installed_worker_signal MATCHES
           "worker_[-][>]isCurrent[(][)]" OR
       _installed_worker_signal MATCHES
           "asio::any_io_executor|template <typename Executor>|using Target = std::variant|WorkerHandle[ \\t]+worker_")
        message(FATAL_ERROR
            "installed WorkerSignal weakened worker affinity or intrusive waiter lifetime")
    endif()
    if(NOT _installed_worker_handle MATCHES
           "std::shared_ptr<detail::WorkerDispatcher> dispatcher_" OR
       _installed_worker_handle MATCHES
           "std::weak_ptr<detail::WorkerDispatcher> dispatcher_" OR
       NOT _installed_worker_timer MATCHES
           "std::shared_ptr<WorkerDispatcher> dispatcher_" OR
       _installed_worker_timer MATCHES
           "std::weak_ptr<WorkerDispatcher> dispatcher_" OR
       NOT _installed_worker_dispatcher MATCHES
           "void detachContext[(][)] noexcept" OR
       NOT _installed_worker_dispatcher MATCHES
           "bool attached[(][)] const noexcept")
        message(FATAL_ERROR
            "installed WorkerHandle restored weak-lock dispatch or lacks explicit context detachment")
    endif()
    if(NOT _installed_worker_wait_awaiter MATCHES
           "struct WorkerWaitAwaitPreparing final" OR
       NOT _installed_worker_wait_awaiter MATCHES
           "class WorkerWaitAwaitSuspended final" OR
       NOT _installed_worker_wait_awaiter MATCHES
           "class WorkerWaitAwaitReadyBeforeSuspend final" OR
       NOT _installed_worker_wait_awaiter MATCHES
           "class WorkerWaitAwaitReadyAfterSuspend final" OR
       NOT _installed_worker_wait_awaiter MATCHES
           "class WorkerWaitAwaitState final" OR
       NOT _installed_worker_wait_awaiter MATCHES
           "using State = std::variant" OR
       NOT _installed_worker_wait_awaiter MATCHES
           "WorkerWaitAwaitState[(]WorkerWaitAwaitState&&[)] = delete" OR
       NOT _installed_channel MATCHES
           "WorkerWaitAwaitState<T> completion" OR
       NOT _installed_one_shot MATCHES
           "WorkerWaitAwaitState<T> completion" OR
       _installed_channel MATCHES
           "std::optional<WorkerWaitResult<T>>|bool suspended|bool wakePending|prepareChannelReceiverWake" OR
       _installed_one_shot MATCHES
           "std::optional<WorkerWaitResult<T>>|bool suspended|bool wakePending|prepareOneShotReceiverWake")
        message(FATAL_ERROR
            "installed worker waits restored parallel await-suspension state")
    endif()
    if(NOT _installed_worker_timer MATCHES
           "enum class WorkerTimerOutcome" OR
       NOT _installed_worker_timer MATCHES
           "kExpired" OR
       NOT _installed_worker_timer MATCHES
           "kCancelled" OR
       NOT _installed_worker_handle MATCHES
           "move_only_function<void[(]WorkerTimerOutcome[)]>" OR
       NOT _installed_worker_dispatcher MATCHES
           "move_only_function<void[(]WorkerTimerOutcome[)]>" OR
       _installed_channel MATCHES
           "[(]bool cancelled[)]" OR
       _installed_one_shot MATCHES
           "[(]bool cancelled[)]")
        message(FATAL_ERROR
            "installed worker timer completion restored a boolean outcome")
    endif()

    set(_installed_task_promise_path
        "${_install_prefix}/include/ruvia/core/detail/TaskPromise.h")
    if(NOT EXISTS "${_installed_task_promise_path}")
        message(FATAL_ERROR
            "installed core package is missing its Task promise state")
    endif()
    file(READ "${_installed_task_promise_path}"
        _installed_task_promise)
    set(_installed_task_path
        "${_install_prefix}/include/ruvia/core/Task.h")
    if(NOT EXISTS "${_installed_task_path}")
        message(FATAL_ERROR
            "installed core package is missing its Task ownership contract")
    endif()
    file(READ "${_installed_task_path}" _installed_task)
    if(NOT _installed_task_promise MATCHES
           "enum class TaskFrameOwnership" OR
       NOT _installed_task_promise MATCHES
           "kCold" OR
       NOT _installed_task_promise MATCHES
           "kStarted" OR
       NOT _installed_task_promise MATCHES
           "void markStarted[(][)] noexcept" OR
       NOT _installed_task_promise MATCHES
           "bool started[(][)] const noexcept" OR
       NOT _installed_task MATCHES
           "!handle[.]done[(][)] && handle[.]promise[(][)][.]started[(][)]" OR
       NOT _installed_task MATCHES
           "std::terminate[(][)]" OR
       _installed_task_promise MATCHES
           "kDetached|detachIfStarted" OR
       _installed_task MATCHES
           "handle_[.]destroy[(][)];[\r\n \t]*handle_ = nullptr")
        message(FATAL_ERROR
            "installed Task lost structured run-to-completion ownership")
    endif()
    if(NOT _installed_task_promise MATCHES
           "struct TaskPromisePending final" OR
       NOT _installed_task_promise MATCHES
           "struct TaskPromiseCompleted final" OR
       NOT _installed_task_promise MATCHES
           "class TaskPromiseValue final" OR
       NOT _installed_task_promise MATCHES
           "class TaskPromiseFailure final" OR
       NOT _installed_task_promise MATCHES
           "using State = std::variant" OR
       NOT _installed_task_promise MATCHES
           "emplace<TaskPromiseValue<T>>" OR
       NOT _installed_task_promise MATCHES
           "emplace<TaskPromiseCompleted>" OR
       NOT _installed_task_promise MATCHES
           "emplace<TaskPromiseFailure>" OR
       _installed_task_promise MATCHES
           "TaskExceptionStorage|hasException_|std::optional<T>[ 	]+value_")
        message(FATAL_ERROR
            "installed Task promise restored parallel value/exception state")
    endif()

    set(_installed_task_completion_path
        "${_install_prefix}/include/ruvia/core/detail/AsioAwait.h")
    if(NOT EXISTS "${_installed_task_completion_path}")
        message(FATAL_ERROR
            "installed core package is missing its Task completion contract")
    endif()
    file(READ "${_installed_task_completion_path}"
        _installed_task_completion)
    if(NOT _installed_task_completion MATCHES
           "class TaskCompletionSuccess final" OR
       NOT _installed_task_completion MATCHES
           "class TaskCompletionFailure final" OR
       NOT _installed_task_completion MATCHES
           "class TaskCompletionResult final" OR
       NOT _installed_task_completion MATCHES
           "using Value = std::variant" OR
       NOT _installed_task_completion MATCHES
           "success[(][)] [&] noexcept" OR
       NOT _installed_task_completion MATCHES
           "failure[(][)] const [&] noexcept" OR
       NOT _installed_task_completion MATCHES
           "success[(][)] && = delete" OR
       NOT _installed_task_completion MATCHES
           "failure[(][)] const && = delete" OR
       _installed_task_completion MATCHES
           "struct TaskCompletionResult|std::optional<T>[ 	]+value|std::exception_ptr[ 	]+exception[;]")
        message(FATAL_ERROR
            "installed Task completion restored a loose exception/value tuple")
    endif()
    if(NOT _installed_task_completion MATCHES
           "struct AsioCompletionPending final" OR
       NOT _installed_task_completion MATCHES
           "class AsioCompletion final" OR
       NOT _installed_task_completion MATCHES
           "class AsioCompletionAwaiter final" OR
       NOT _installed_task_completion MATCHES
           "using State = std::variant" OR
       NOT _installed_task_completion MATCHES
           "errorCode[(][)] const noexcept" OR
       NOT _installed_task_completion MATCHES
           "result[(][)] const [&] noexcept" OR
       NOT _installed_task_completion MATCHES
           "result[(][)] const && = delete" OR
       NOT _installed_task_completion MATCHES
           "takeResult[(][)] &&" OR
       NOT _installed_task_completion MATCHES
           "asyncAsio" OR
       _installed_task_completion MATCHES
           "ErrorAwaiter|ErrorResultAwaiter|asyncError|asyncResult|std::pair<std::error_code")
        message(FATAL_ERROR
            "installed Asio adapter restored split or positional completion results")
    endif()

    set(_installed_worker_wait_result_path
        "${_install_prefix}/include/ruvia/core/WorkerWaitResult.h")
    if(NOT EXISTS "${_installed_worker_wait_result_path}")
        message(FATAL_ERROR
            "installed core package is missing WorkerWaitResult")
    endif()
    file(READ "${_installed_worker_wait_result_path}"
        _installed_worker_wait_result)
    if(NOT _installed_worker_wait_result MATCHES
           "value[(][)] const [&] noexcept" OR
       NOT _installed_worker_wait_result MATCHES
           "value[(][)] [&] noexcept" OR
       NOT _installed_worker_wait_result MATCHES
           "value[(][)] const && = delete" OR
       NOT _installed_worker_wait_result MATCHES
           "value[(][)] && = delete" OR
       NOT _installed_worker_wait_result MATCHES
           "closed[(][)] const [&] noexcept" OR
       NOT _installed_worker_wait_result MATCHES
           "timedOut[(][)] const && = delete")
        message(FATAL_ERROR
            "installed WorkerWaitResult exposes alternatives from temporary owners")
    endif()

    set(_installed_pool_waiter_path
        "${_install_prefix}/include/ruvia/core/detail/PoolWaiterQueue.h")
    if(NOT EXISTS "${_installed_pool_waiter_path}")
        message(FATAL_ERROR
            "installed core package is missing its typed pool waiter contract")
    endif()
    file(READ "${_installed_pool_waiter_path}" _installed_pool_waiter)
    if(NOT _installed_pool_waiter MATCHES
           "class PoolWaiterAcquired final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterTimedOut final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterClosed final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterResult final" OR
       NOT _installed_pool_waiter MATCHES "using Value = std::variant" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterAcquired>" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterTimedOut>" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterClosed>" OR
       NOT _installed_pool_waiter MATCHES
           "acquired[(][)] const [&] noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "timedOut[(][)] const [&] noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "closed[(][)] const [&] noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "acquired[(][)] const && = delete" OR
       NOT _installed_pool_waiter MATCHES
           "struct PoolWaiterIdle final" OR
       NOT _installed_pool_waiter MATCHES
           "struct PoolWaiterQueued final" OR
       NOT _installed_pool_waiter MATCHES "using State = std::variant" OR
       NOT _installed_pool_waiter MATCHES
           "holds_alternative<PoolWaiterResult>" OR
       NOT _installed_pool_waiter MATCHES
           "holds_alternative<PoolWaiterQueued>" OR
       NOT _installed_pool_waiter MATCHES
           "bool await_ready[(][)] const noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "const PoolWaiterResult& await_resume[(][)] const noexcept" OR
       NOT _installed_pool_waiter MATCHES "void closeAll[(][)] noexcept" OR
       _installed_pool_waiter MATCHES
           "std::optional<PoolWaiterResult>|bool queued_")
        message(FATAL_ERROR
            "installed pool waiter lost its discriminated await completion")
    endif()
    if(_installed_pool_waiter MATCHES
           "bool[ \t]*&[ \t]*(ready|timedOut)" OR
       _installed_pool_waiter MATCHES
           "bool[*][ \t]*(ready_|timedOut_)" OR
       _installed_pool_waiter MATCHES "sentinelIndex" OR
       _installed_pool_waiter MATCHES "WaiterAwaiter" OR
       _installed_pool_waiter MATCHES "setHandle[ \t]*[(]" OR
       _installed_pool_waiter MATCHES
           "PoolWaiterResult[*][ \t]+result[ \t]*[(]" OR
       _installed_pool_waiter MATCHES
           "closeAll[ \t\r\n]*[(][^)]*std::size_t")
        message(FATAL_ERROR
            "installed pool waiter restored parallel completion state or a close sentinel")
    endif()

    set(_installed_pool_lease_scheduler_path
        "${_install_prefix}/include/ruvia/core/detail/PoolLeaseScheduler.h")
    if(NOT EXISTS "${_installed_pool_lease_scheduler_path}")
        message(FATAL_ERROR
            "installed core package is missing PoolLeaseScheduler")
    endif()
    file(READ "${_installed_pool_lease_scheduler_path}"
        _installed_pool_lease_scheduler)
    if(NOT _installed_pool_lease_scheduler MATCHES
           "class PoolLeaseScheduler final" OR
       NOT _installed_pool_lease_scheduler MATCHES
           "Task<PoolWaiterResult> acquire" OR
       NOT _installed_pool_lease_scheduler MATCHES
           "waiters_[.]resumeNext" OR
       NOT _installed_pool_lease_scheduler MATCHES
           "waiters_[.]closeAll" OR
       NOT _installed_pool_lease_scheduler MATCHES
           "enum class PoolLeaseReleaseStatus" OR
       NOT _installed_pool_lease_scheduler MATCHES
           "PoolLeaseReleaseStatus release" OR
       NOT _installed_pool_lease_scheduler MATCHES
           "vector<std::size_t> freeSlots_" OR
       NOT _installed_pool_lease_scheduler MATCHES
           "vector<std::uint8_t> busy_")
        message(FATAL_ERROR
            "installed core pool scheduler lost centralized lease ownership")
    endif()

    set(_installed_connection_scanner_path
        "${_install_prefix}/include/ruvia/core/detail/ConnectionScanner.h")
    if(NOT EXISTS "${_installed_connection_scanner_path}")
        message(FATAL_ERROR
            "installed core package is missing ConnectionScanner")
    endif()
    file(READ "${_installed_connection_scanner_path}"
        _installed_connection_scanner)
    if(NOT _installed_connection_scanner MATCHES
           "class PeriodicCheckRegistration final" OR
       NOT _installed_connection_scanner MATCHES
           "void registerPeriodicCheck" OR
       NOT _installed_connection_scanner MATCHES
           "using PeriodicCheck = void [(][*][)][(]void[*], std::int64_t[)] noexcept" OR
       _installed_connection_scanner MATCHES
           "using PeriodicCheck = bool" OR
       NOT _installed_connection_scanner MATCHES
           "PeriodicCheckRegistration[*][ \t]+periodicChecks_" OR
       NOT _installed_connection_scanner MATCHES
           "class WorkerMaintenanceRegistration final" OR
       NOT _installed_connection_scanner MATCHES
           "void registerWorkerMaintenance" OR
       NOT _installed_connection_scanner MATCHES
           "WorkerMaintenanceRegistration[*][ \t]+workerMaintenance_" OR
       _installed_connection_scanner MATCHES
           "kMaxPeriodicChecks|PeriodicCheckSlot|workerScanners_|setWorkerScanner")
        message(FATAL_ERROR
            "installed connection scanner regained a fixed check ceiling")
    endif()
endif()

if(_built_components_csv MATCHES "(^|,)http(,|$)")
set(_installed_http_operation_h1
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ServerSemantics.h")
set(_installed_http_operation_h2_connection
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2Connection.h")
set(_installed_http_operation_h2_peer
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2PeerSettings.h")
set(_installed_http_operation_h2_plan
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2ResponseHeadPlan.h")
set(_installed_http_operation_control
    "${_install_prefix}/include/ruvia/http/detail/server/HttpFinalResponseControlPlan.h")
set(_installed_http_operation_trailers
    "${_install_prefix}/include/ruvia/http/detail/server/HttpResponseTrailers.h")
foreach(_installed_http_operation_path IN ITEMS
        "${_installed_http_operation_h1}"
        "${_installed_http_operation_h2_connection}"
        "${_installed_http_operation_h2_peer}"
        "${_installed_http_operation_h2_plan}"
        "${_installed_http_operation_control}"
        "${_installed_http_operation_trailers}")
    if(NOT EXISTS "${_installed_http_operation_path}")
        message(FATAL_ERROR
            "installed HTTP package is missing an operation-result lifetime contract")
    endif()
endforeach()
file(READ "${_installed_http_operation_h1}" _installed_http_operation_h1_text)
file(READ "${_installed_http_operation_h2_connection}"
    _installed_http_operation_h2_connection_text)
file(READ "${_installed_http_operation_h2_peer}"
    _installed_http_operation_h2_peer_text)
file(READ "${_installed_http_operation_h2_plan}"
    _installed_http_operation_h2_plan_text)
file(READ "${_installed_http_operation_control}"
    _installed_http_operation_control_text)
file(READ "${_installed_http_operation_trailers}"
    _installed_http_operation_trailers_text)
if(NOT _installed_http_operation_h1_text MATCHES
       "committed[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h1_text MATCHES
       "prepared[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h1_text MATCHES
       "prepared[(][)] [&] noexcept" OR
   NOT _installed_http_operation_h1_text MATCHES
       "committed[(][)] const && = delete" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "WebSocketServerNegotiation[*][ \t\r\n]+submitted[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "Http2SubmittedRequestHead[*][ \t\r\n]+submitted[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "const Plan[*] submitted[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "submitted[(][)] const && = delete" OR
   NOT _installed_http_operation_h2_peer_text MATCHES
       "applied[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_peer_text MATCHES
       "initialWindowChange[(][)] const && = delete" OR
   NOT _installed_http_operation_h2_plan_text MATCHES
       "plan[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_control_text MATCHES
       "control[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_control_text MATCHES
       "control[(][)] const && = delete" OR
   NOT _installed_http_operation_trailers_text MATCHES
       "section[(][)] const [&] noexcept" OR
