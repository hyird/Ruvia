    _installed_multipart_parsing)
if(_installed_multipart_parser MATCHES
       "partBegin[ \\t]*\\(|partEnd[ \\t]*\\(|appendChunk[ \\t]*\\(|enum class PollStatus|MultipartParser::PollResult|MultipartParser[ \\t\\r\\n]*\\([ \\t\\r\\n]*std::string_view" OR
   _installed_multipart_parsing MATCHES
       "HttpMultipartDelimiter(Status|Match)|HttpMultipartBoundaryParseStatus|HttpMultipartPartHeaderStatus|httpParseMultipartPartHeaders[ \\t\\r\\n]*\\([^)]*HttpMultipartPartHeaders[ \\t]*&")
    message(FATAL_ERROR "installed multipart parser contains a stale raw-boundary or status/payload tuple API")
endif()
if(NOT _installed_multipart_parser MATCHES "class MultipartBoundary final" OR
   NOT _installed_multipart_parser MATCHES "enum class MultipartChunkPhase" OR
   NOT _installed_multipart_parser MATCHES "class MultipartPollNeedInput final" OR
   NOT _installed_multipart_parser MATCHES "class MultipartPollDone final" OR
   NOT _installed_multipart_parser MATCHES "enum class MultipartParseError" OR
   NOT _installed_multipart_parser MATCHES "class MultipartPollFailure final" OR
   NOT _installed_multipart_parser MATCHES "class MultipartPollResult final" OR
   NOT _installed_multipart_parser MATCHES "using Value = std::variant" OR
   NOT _installed_multipart_parser MATCHES "std::get_if<MultipartStreamPart>" OR
   NOT _installed_multipart_parser MATCHES "std::get_if<MultipartPollFailure>" OR
   NOT _installed_multipart_parser MATCHES "multipartParseErrorMessage" OR
   NOT _installed_multipart_parser MATCHES "void finishInput[(][)] noexcept" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartDelimiterNoMatch final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartDelimiterNeedInput final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartPartDelimiter final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartCloseDelimiter final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartDelimiterResult final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartBoundaryParseFailure final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartBoundaryParseResult final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartPartHeaderParseFailure final" OR
   NOT _installed_multipart_parsing MATCHES "class HttpMultipartPartHeaderParseResult final")
    message(FATAL_ERROR "installed multipart parser lost its discriminated boundary/input lifecycle API")
endif()
endif()

function(ruvia_verify_package_consumer
    name prefix components visible_components available_components optional_components
    expect_configure_failure)
    set(_build_dir "${_consumer_build}/${name}")
    file(REMOVE_RECURSE "${_build_dir}")

    set(_configure_command
        "@CMAKE_COMMAND@"
        -S "@CMAKE_SOURCE_DIR@/tests/package-consumer"
        -B "${_build_dir}"
        -G "@CMAKE_GENERATOR@"
        "-DCMAKE_PREFIX_PATH=${prefix}"
        "-DCMAKE_CONFIGURATION_TYPES=${RUVIA_CONFIG}"
        "-DRUVIA_PACKAGE_COMPONENTS=${components}"
        "-DRUVIA_PACKAGE_OPTIONAL_COMPONENTS=${optional_components}"
        "-DRUVIA_EXPECT_VISIBLE_COMPONENTS=${visible_components}"
        "-DRUVIA_EXPECT_AVAILABLE_COMPONENTS=${available_components}")

    if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
        list(APPEND _configure_command -A "@CMAKE_GENERATOR_PLATFORM@")
    endif()
    if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
        list(APPEND _configure_command -T "@CMAKE_GENERATOR_TOOLSET@")
    endif()
    if(NOT "@CMAKE_TOOLCHAIN_FILE@" STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_TOOLCHAIN_FILE=@CMAKE_TOOLCHAIN_FILE@")
    endif()
    if(NOT "@VCPKG_TARGET_TRIPLET@" STREQUAL "")
        list(APPEND _configure_command "-DVCPKG_TARGET_TRIPLET=@VCPKG_TARGET_TRIPLET@")
    endif()
    if(NOT "@VCPKG_INSTALLED_DIR@" STREQUAL "")
        list(APPEND _configure_command "-DVCPKG_INSTALLED_DIR=@VCPKG_INSTALLED_DIR@")
    endif()
    if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@")
    endif()
    if(NOT "@CMAKE_CXX_FLAGS@" STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@")
    endif()
    if(NOT "@CMAKE_EXE_LINKER_FLAGS@" STREQUAL "")
        list(APPEND _configure_command "-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@")
    endif()

    execute_process(COMMAND ${_configure_command} RESULT_VARIABLE _configure_result)
    if(expect_configure_failure)
        if(_configure_result EQUAL 0)
            message(FATAL_ERROR
                "Ruvia package consumer '${name}' unexpectedly accepted a missing required component")
        endif()
        return()
    endif()
    if(NOT _configure_result EQUAL 0)
        message(FATAL_ERROR
            "Ruvia package consumer '${name}' configure failed: ${_configure_result}")
    endif()

    execute_process(
        COMMAND "@CMAKE_COMMAND@" --build "${_build_dir}"
            --config "${RUVIA_CONFIG}" --parallel
        RESULT_VARIABLE _build_result)
    if(NOT _build_result EQUAL 0)
        message(FATAL_ERROR
            "Ruvia package consumer '${name}' build failed: ${_build_result}")
    endif()
endfunction()

function(ruvia_install_component_package name components_csv)
    set(_prefix "${_component_install_root}/${name}")
    string(REPLACE "," ";" _components "${components_csv}")
    foreach(_component IN LISTS _components)
        execute_process(
            COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@"
                --config "${RUVIA_CONFIG}"
                --prefix "${_prefix}"
                --component "${_component}"
            RESULT_VARIABLE _component_install_result)
        if(NOT _component_install_result EQUAL 0)
            message(FATAL_ERROR
                "Ruvia '${name}' component install failed for ${_component}: ${_component_install_result}")
        endif()
    endforeach()
    execute_process(
        COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@"
            --config "${RUVIA_CONFIG}"
            --prefix "${_prefix}"
            --component Development
        RESULT_VARIABLE _development_install_result)
    if(NOT _development_install_result EQUAL 0)
        message(FATAL_ERROR
            "Ruvia '${name}' Development install failed: ${_development_install_result}")
    endif()

    foreach(_component IN ITEMS core http web)
        set(_export
            "${_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruvia-${_component}-targets.cmake")
        if(_component IN_LIST _components)
            if(NOT EXISTS "${_export}")
                message(FATAL_ERROR
                    "Ruvia '${name}' install omitted the ${_component} target export")
            endif()
        elseif(EXISTS "${_export}")
            message(FATAL_ERROR
                "Ruvia '${name}' install leaked the ${_component} target export")
        endif()
    endforeach()

    set(${name}_PREFIX "${_prefix}" PARENT_SCOPE)
endfunction()

# A full install exposes every available component but imports only the requested
# target closure into each consuming project.
ruvia_verify_package_consumer(
    full-all "${_install_prefix}" "${_built_components_csv}"
    "${_built_components_csv}" "${_built_components_csv}" "" FALSE)

if("core" IN_LIST _built_components)
    ruvia_verify_package_consumer(
        full-core "${_install_prefix}" core core "${_built_components_csv}"
        unavailable FALSE)

    ruvia_install_component_package(partial_core core)
    ruvia_verify_package_consumer(
        partial-core "${partial_core_PREFIX}" core core core unavailable FALSE)
    ruvia_verify_package_consumer(
        partial-core-missing-web "${partial_core_PREFIX}" web "" core "" TRUE)
endif()

if("http" IN_LIST _built_components)
    ruvia_verify_package_consumer(
        full-http "${_install_prefix}" http http "${_built_components_csv}"
        unavailable FALSE)

    ruvia_install_component_package(partial_http http)
    ruvia_verify_package_consumer(
        partial-http "${partial_http_PREFIX}" http http http unavailable FALSE)
    ruvia_verify_package_consumer(
        partial-http-missing-core "${partial_http_PREFIX}" core "" http "" TRUE)
endif()

if("web" IN_LIST _built_components)
    ruvia_verify_package_consumer(
        full-web "${_install_prefix}" web "core,http,web"
        "${_built_components_csv}" unavailable FALSE)

    # A web artifact without both lower target exports is deliberately not a
    # usable package component; install the full closure for the success case.
    ruvia_install_component_package(partial_web_only web)
    ruvia_verify_package_consumer(
        partial-web-missing-dependencies "${partial_web_only_PREFIX}"
        web "" "" "" TRUE)

    ruvia_install_component_package(partial_web_closure "core,http,web")
    ruvia_verify_package_consumer(
        partial-web-closure "${partial_web_closure_PREFIX}" web "core,http,web"
        "core,http,web" unavailable FALSE)
endif()
