if(_installed_ws_event MATCHES "struct[ \t]+WsEvent[ \t]+final" OR
   _installed_ws_event MATCHES "WsEvent::Kind" OR
   _installed_ws_event MATCHES "Kind::kNone")
    message(FATAL_ERROR "installed WebSocket core restored the loose sentinel event tuple")
endif()
if(NOT _installed_ws_inbound MATCHES
       "enum class WebSocketProtocolFailure" OR
   NOT _installed_ws_inbound MATCHES
       "class WebSocketFrameNeedInput final" OR
   NOT _installed_ws_inbound MATCHES
       "class WebSocketFrameReadFailure final" OR
   NOT _installed_ws_inbound MATCHES
       "class WebSocketFrameReadResult final" OR
   NOT _installed_ws_inbound MATCHES
       "std::get_if<WebSocketFrameNeedInput>" OR
   NOT _installed_ws_inbound MATCHES
       "std::get_if<WebSocketFrameView>" OR
   NOT _installed_ws_inbound MATCHES
       "std::get_if<WebSocketFrameReadFailure>" OR
   NOT _installed_ws_inbound MATCHES
