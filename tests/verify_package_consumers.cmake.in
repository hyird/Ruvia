if(_installed_http2_event MATCHES "struct[ \t]+Http2Event[ \t]+final" OR
   _installed_http2_event MATCHES "Http2Event::Kind" OR
   _installed_http2_event MATCHES "Kind::kNone")
    message(FATAL_ERROR "installed HTTP/2 core restored the loose sentinel event tuple")
endif()
set(_installed_ws_connection_path
    "${_install_prefix}/include/ruvia/http/detail/websocket/WsConnection.h")
set(_installed_ws_event_path
    "${_install_prefix}/include/ruvia/http/detail/websocket/WsEvent.h")
