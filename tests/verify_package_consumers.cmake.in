cmake_minimum_required(VERSION 3.24)

set(_install_prefix "@CMAKE_BINARY_DIR@/package-consumer-install")
set(_consumer_build "@CMAKE_BINARY_DIR@/package-consumer-build")
set(_component_install_root "@CMAKE_BINARY_DIR@/package-component-installs")
set(_built_components "@RUVIA_BUILT_COMPONENTS@")
set(_built_components_csv "@RUVIA_BUILT_COMPONENTS_CSV@")

file(REMOVE_RECURSE
    "${_install_prefix}"
    "${_consumer_build}"
    "${_component_install_root}")

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --config "${RUVIA_CONFIG}" --prefix "${_install_prefix}"
    RESULT_VARIABLE _install_result)
if(NOT _install_result EQUAL 0)
    message(FATAL_ERROR "Ruvia package install failed: ${_install_result}")
endif()

if(EXISTS "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruviaTargets.cmake")
    message(FATAL_ERROR "obsolete monolithic Ruvia target export was installed")
endif()
foreach(_ruvia_component IN ITEMS core http web)
    if(_ruvia_component IN_LIST _built_components AND
       NOT EXISTS
           "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/ruvia/ruvia-${_ruvia_component}-targets.cmake")
        message(FATAL_ERROR "component target export was not installed: ${_ruvia_component}")
    endif()
endforeach()

if(_built_components_csv MATCHES "(^|,)core(,|$)" AND
   NOT EXISTS "${_install_prefix}/include/ruvia/core/detail/Base64Url.h")
    message(FATAL_ERROR "core base64url helper was not installed")
endif()

if(_built_components_csv MATCHES "(^|,)core(,|$)")
    set(_installed_worker_wait_result_path
        "${_install_prefix}/include/ruvia/core/WorkerWaitResult.h")
    if(NOT EXISTS "${_installed_worker_wait_result_path}")
        message(FATAL_ERROR
            "installed core package is missing WorkerWaitResult")
    endif()
    file(READ "${_installed_worker_wait_result_path}"
        _installed_worker_wait_result)
    if(NOT _installed_worker_wait_result MATCHES
           "value[(][)] const [&] noexcept" OR
       NOT _installed_worker_wait_result MATCHES
           "value[(][)] [&] noexcept" OR
       NOT _installed_worker_wait_result MATCHES
           "value[(][)] const && = delete" OR
       NOT _installed_worker_wait_result MATCHES
           "value[(][)] && = delete" OR
       NOT _installed_worker_wait_result MATCHES
           "closed[(][)] const [&] noexcept" OR
       NOT _installed_worker_wait_result MATCHES
           "timedOut[(][)] const && = delete")
        message(FATAL_ERROR
            "installed WorkerWaitResult exposes alternatives from temporary owners")
    endif()

    set(_installed_pool_waiter_path
        "${_install_prefix}/include/ruvia/core/detail/PoolWaiterQueue.h")
    if(NOT EXISTS "${_installed_pool_waiter_path}")
        message(FATAL_ERROR
            "installed core package is missing its typed pool waiter contract")
    endif()
    file(READ "${_installed_pool_waiter_path}" _installed_pool_waiter)
    if(NOT _installed_pool_waiter MATCHES
           "class PoolWaiterAcquired final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterTimedOut final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterClosed final" OR
       NOT _installed_pool_waiter MATCHES
           "class PoolWaiterResult final" OR
       NOT _installed_pool_waiter MATCHES "using Value = std::variant" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterAcquired>" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterTimedOut>" OR
       NOT _installed_pool_waiter MATCHES
           "std::get_if<PoolWaiterClosed>" OR
       NOT _installed_pool_waiter MATCHES
           "acquired[(][)] const [&] noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "timedOut[(][)] const [&] noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "closed[(][)] const [&] noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "acquired[(][)] const && = delete" OR
       NOT _installed_pool_waiter MATCHES
           "std::optional<PoolWaiterResult> result_" OR
       NOT _installed_pool_waiter MATCHES
           "bool await_ready[(][)] const noexcept" OR
       NOT _installed_pool_waiter MATCHES
           "const PoolWaiterResult& await_resume[(][)] const noexcept" OR
       NOT _installed_pool_waiter MATCHES "void closeAll[(][)] noexcept")
        message(FATAL_ERROR
            "installed pool waiter lost its discriminated await completion")
    endif()
    if(_installed_pool_waiter MATCHES
           "bool[ \t]*&[ \t]*(ready|timedOut)" OR
       _installed_pool_waiter MATCHES
           "bool[*][ \t]*(ready_|timedOut_)" OR
       _installed_pool_waiter MATCHES "sentinelIndex" OR
       _installed_pool_waiter MATCHES "WaiterAwaiter" OR
       _installed_pool_waiter MATCHES "setHandle[ \t]*[(]" OR
       _installed_pool_waiter MATCHES
           "PoolWaiterResult[*][ \t]+result[ \t]*[(]" OR
       _installed_pool_waiter MATCHES
           "closeAll[ \t\r\n]*[(][^)]*std::size_t")
        message(FATAL_ERROR
            "installed pool waiter restored parallel completion state or a close sentinel")
    endif()
endif()

if(_built_components_csv MATCHES "(^|,)http(,|$)")
set(_installed_http_operation_h1
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ServerSemantics.h")
set(_installed_http_operation_h2_connection
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2Connection.h")
set(_installed_http_operation_h2_peer
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2PeerSettings.h")
set(_installed_http_operation_h2_plan
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2ResponseHeadPlan.h")
set(_installed_http_operation_control
    "${_install_prefix}/include/ruvia/http/detail/server/HttpFinalResponseControlPlan.h")
set(_installed_http_operation_trailers
    "${_install_prefix}/include/ruvia/http/detail/server/HttpResponseTrailers.h")
foreach(_installed_http_operation_path IN ITEMS
        "${_installed_http_operation_h1}"
        "${_installed_http_operation_h2_connection}"
        "${_installed_http_operation_h2_peer}"
        "${_installed_http_operation_h2_plan}"
        "${_installed_http_operation_control}"
        "${_installed_http_operation_trailers}")
    if(NOT EXISTS "${_installed_http_operation_path}")
        message(FATAL_ERROR
            "installed HTTP package is missing an operation-result lifetime contract")
    endif()
endforeach()
file(READ "${_installed_http_operation_h1}" _installed_http_operation_h1_text)
file(READ "${_installed_http_operation_h2_connection}"
    _installed_http_operation_h2_connection_text)
file(READ "${_installed_http_operation_h2_peer}"
    _installed_http_operation_h2_peer_text)
file(READ "${_installed_http_operation_h2_plan}"
    _installed_http_operation_h2_plan_text)
file(READ "${_installed_http_operation_control}"
    _installed_http_operation_control_text)
file(READ "${_installed_http_operation_trailers}"
    _installed_http_operation_trailers_text)
if(NOT _installed_http_operation_h1_text MATCHES
       "committed[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h1_text MATCHES
       "prepared[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h1_text MATCHES
       "prepared[(][)] [&] noexcept" OR
   NOT _installed_http_operation_h1_text MATCHES
       "committed[(][)] const && = delete" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "WebSocketServerNegotiation[*][ \t\r\n]+submitted[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "Http2SubmittedRequestHead[*][ \t\r\n]+submitted[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "const Plan[*] submitted[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_connection_text MATCHES
       "submitted[(][)] const && = delete" OR
   NOT _installed_http_operation_h2_peer_text MATCHES
       "applied[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_h2_peer_text MATCHES
       "initialWindowChange[(][)] const && = delete" OR
   NOT _installed_http_operation_h2_plan_text MATCHES
       "plan[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_control_text MATCHES
       "http1[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_control_text MATCHES
       "http1[(][)] const && = delete" OR
   NOT _installed_http_operation_control_text MATCHES
       "http2[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_control_text MATCHES
       "http2[(][)] const && = delete" OR
   NOT _installed_http_operation_trailers_text MATCHES
       "section[(][)] const [&] noexcept" OR
   NOT _installed_http_operation_trailers_text MATCHES
       "section[(][)] const && = delete")
    message(FATAL_ERROR
        "installed HTTP operation results expose alternatives from temporary owners")
endif()

set(_installed_http_protocol_plan_range
    "${_install_prefix}/include/ruvia/http/detail/HttpByteRange.h")
set(_installed_http_protocol_plan_semantics
    "${_install_prefix}/include/ruvia/http/detail/HttpResponseContentSemantics.h")
set(_installed_http_protocol_plan_write
    "${_install_prefix}/include/ruvia/http/detail/server/HttpResponseWritePlan.h")
set(_installed_http_protocol_plan_h1_request
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1RequestBodyPlan.h")
set(_installed_http_protocol_plan_h1_response
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ResponseHeadPlan.h")
set(_installed_http_protocol_plan_h2_request
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2RequestContent.h")
set(_installed_http_protocol_plan_h2_response
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2ResponseHeadPlan.h")
set(_installed_http_protocol_plan_control
    "${_install_prefix}/include/ruvia/http/detail/server/HttpFinalResponseControlPlan.h")
set(_installed_http_protocol_plan_stream
    "${_install_prefix}/include/ruvia/http/detail/server/HttpResponseStreamHead.h")
set(_installed_http_protocol_request_facts
    "${_install_prefix}/include/ruvia/http/detail/HttpExpectations.h")
set(_installed_http_protocol_connection_facts
    "${_install_prefix}/include/ruvia/http/detail/HttpConnectionFields.h")
set(_installed_http_protocol_client_request_context
    "${_install_prefix}/include/ruvia/http/Http1ClientRequestWriter.h")
foreach(_installed_http_protocol_plan_path IN ITEMS
        "${_installed_http_protocol_plan_range}"
        "${_installed_http_protocol_plan_semantics}"
        "${_installed_http_protocol_plan_write}"
        "${_installed_http_protocol_plan_h1_request}"
        "${_installed_http_protocol_plan_h1_response}"
        "${_installed_http_protocol_plan_h2_request}"
        "${_installed_http_protocol_plan_h2_response}"
        "${_installed_http_protocol_plan_control}"
        "${_installed_http_protocol_plan_stream}"
        "${_installed_http_protocol_request_facts}"
        "${_installed_http_protocol_connection_facts}"
        "${_installed_http_protocol_client_request_context}")
    if(NOT EXISTS "${_installed_http_protocol_plan_path}")
        message(FATAL_ERROR
            "installed HTTP package is missing a protocol-plan lifetime contract")
    endif()
endforeach()
file(READ "${_installed_http_protocol_plan_range}"
    _installed_http_protocol_plan_range_text)
file(READ "${_installed_http_protocol_plan_semantics}"
    _installed_http_protocol_plan_semantics_text)
file(READ "${_installed_http_protocol_plan_write}"
    _installed_http_protocol_plan_write_text)
file(READ "${_installed_http_protocol_plan_h1_request}"
    _installed_http_protocol_plan_h1_request_text)
file(READ "${_installed_http_protocol_plan_h1_response}"
    _installed_http_protocol_plan_h1_response_text)
file(READ "${_installed_http_protocol_plan_h2_request}"
    _installed_http_protocol_plan_h2_request_text)
file(READ "${_installed_http_protocol_plan_h2_response}"
    _installed_http_protocol_plan_h2_response_text)
file(READ "${_installed_http_protocol_plan_control}"
    _installed_http_protocol_plan_control_text)
file(READ "${_installed_http_protocol_plan_stream}"
    _installed_http_protocol_plan_stream_text)
file(READ "${_installed_http_protocol_request_facts}"
    _installed_http_protocol_request_facts_text)
file(READ "${_installed_http_protocol_connection_facts}"
    _installed_http_protocol_connection_facts_text)
file(READ "${_installed_http_protocol_client_request_context}"
    _installed_http_protocol_client_request_context_text)
if(NOT _installed_http_protocol_plan_range_text MATCHES
       "resolved[(][)] const && = delete" OR
   NOT _installed_http_protocol_plan_semantics_text MATCHES
       "bool informational[(][)] const noexcept" OR
   NOT _installed_http_protocol_plan_semantics_text MATCHES
       "bool withContent[(][)] const noexcept" OR
   NOT _installed_http_protocol_plan_semantics_text MATCHES
       "is_trivially_copyable_v<HttpResponseContentSemantics>" OR
   NOT _installed_http_protocol_plan_semantics_text MATCHES
       "sizeof[(]HttpResponseContentSemantics[)] <= 2" OR
   NOT _installed_http_protocol_plan_write_text MATCHES
       "HttpResponseContentSemantics[ \t\r\n]+contentSemantics[(][)] const noexcept" OR
   NOT _installed_http_protocol_plan_write_text MATCHES
       "HttpResponseBodyPlan bodyPlan[(][)] const noexcept" OR
   NOT _installed_http_protocol_plan_write_text MATCHES
       "is_trivially_copyable_v<HttpResponseBodyPlan>" OR
   NOT _installed_http_protocol_plan_write_text MATCHES
       "sizeof[(]HttpResponseBodyPlan[)] <= 12" OR
   NOT _installed_http_protocol_plan_h1_request_text MATCHES
       "HttpRequestExpectations[ \t]+expectations[(][)] const noexcept" OR
   NOT _installed_http_protocol_request_facts_text MATCHES
       "is_trivially_copyable_v<HttpRequestExpectations>" OR
   NOT _installed_http_protocol_request_facts_text MATCHES
       "sizeof[(]HttpRequestExpectations[)] <= 1" OR
   NOT _installed_http_protocol_plan_h1_response_text MATCHES
       "HttpResponseBodyPlan bodyPlan[(][)] const noexcept" OR
   NOT _installed_http_protocol_plan_h1_response_text MATCHES
       "headPlan[(][)] const && = delete" OR
   NOT _installed_http_protocol_plan_h2_request_text MATCHES
       "streamingContent[(][)] const && = delete" OR
   NOT _installed_http_protocol_plan_h2_response_text MATCHES
       "HttpResponseBodyPlan bodyPlan[(][)] const noexcept" OR
   NOT _installed_http_protocol_plan_h2_response_text MATCHES
       "forbiddenContentLength[(][)] const && = delete" OR
   NOT _installed_http_protocol_plan_control_text MATCHES
       "http2[(][)] const && = delete" OR
   NOT _installed_http_protocol_plan_control_text MATCHES
       "HttpConnectionOptions[ \t\r\n]+connectionOptions[(][)] const noexcept" OR
   NOT _installed_http_protocol_plan_control_text MATCHES
       "HttpUpgradeProtocols[ \t\r\n]+upgradeProtocols[(][)] const noexcept" OR
   NOT _installed_http_protocol_client_request_context_text MATCHES
       "HttpConnectionOptions[ \t]+connectionOptions[(][)] const noexcept" OR
   NOT _installed_http_protocol_connection_facts_text MATCHES
       "is_trivially_copyable_v<HttpConnectionOptions>" OR
   NOT _installed_http_protocol_connection_facts_text MATCHES
       "sizeof[(]HttpConnectionOptions[)] <= 2" OR
   NOT _installed_http_protocol_connection_facts_text MATCHES
       "is_trivially_copyable_v<HttpUpgradeProtocols>" OR
   NOT _installed_http_protocol_connection_facts_text MATCHES
       "sizeof[(]HttpUpgradeProtocols[)] <= 2" OR
   NOT _installed_http_protocol_plan_stream_text MATCHES
       "HttpResponseBodyPlan bodyPlan[(][)] const noexcept")
    message(FATAL_ERROR
        "installed HTTP protocol plan fact ownership is inconsistent")
endif()

set(_installed_http_operation_payload_request
    "${_install_prefix}/include/ruvia/http/Http1RequestParser.h")
set(_installed_http_operation_payload_client_response
    "${_install_prefix}/include/ruvia/http/Http1ClientResponseParser.h")
set(_installed_http_operation_payload_client_request
    "${_install_prefix}/include/ruvia/http/Http1ClientRequestWriter.h")
set(_installed_http_operation_payload_h1
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ServerSemantics.h")
set(_installed_http_operation_payload_stream
    "${_install_prefix}/include/ruvia/http/detail/server/HttpResponseStreamHead.h")
set(_installed_http_operation_payload_websocket
    "${_install_prefix}/include/ruvia/http/detail/websocket/HttpWebSocketServerHandshake.h")
foreach(_installed_http_operation_payload_path IN ITEMS
        "${_installed_http_operation_payload_request}"
        "${_installed_http_operation_payload_client_response}"
        "${_installed_http_operation_payload_client_request}"
        "${_installed_http_operation_payload_h1}"
        "${_installed_http_operation_payload_stream}"
        "${_installed_http_operation_payload_websocket}")
    if(NOT EXISTS "${_installed_http_operation_payload_path}")
        message(FATAL_ERROR
            "installed HTTP package is missing an operation-payload lifetime contract")
    endif()
endforeach()
file(READ "${_installed_http_operation_payload_request}"
    _installed_http_operation_payload_request_text)
file(READ "${_installed_http_operation_payload_client_response}"
    _installed_http_operation_payload_client_response_text)
file(READ "${_installed_http_operation_payload_client_request}"
    _installed_http_operation_payload_client_request_text)
file(READ "${_installed_http_operation_payload_h1}"
    _installed_http_operation_payload_h1_text)
file(READ "${_installed_http_operation_payload_stream}"
    _installed_http_operation_payload_stream_text)
file(READ "${_installed_http_operation_payload_websocket}"
    _installed_http_operation_payload_websocket_text)
if(NOT _installed_http_operation_payload_request_text MATCHES
       "bodyPlan[(][)] const && = delete" OR
   NOT _installed_http_operation_payload_client_response_text MATCHES
       "plan[(][)] const && = delete" OR
   NOT _installed_http_operation_payload_client_request_text MATCHES
       "contentPlan[(][)] const && = delete" OR
   NOT _installed_http_operation_payload_stream_text MATCHES
       "response[(][)] && = delete" OR
   NOT _installed_http_operation_payload_stream_text MATCHES
       "commitPlan[(][)] const && = delete" OR
   NOT _installed_http_operation_payload_h1_text MATCHES
       "responseHeadPlan[(][)] const && = delete" OR
   NOT _installed_http_operation_payload_websocket_text MATCHES
       "negotiation[(][)] const && = delete")
    message(FATAL_ERROR
        "installed HTTP operation payloads expose owned state from temporary values")
endif()

set(_removed_http2_frame_umbrella
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2Frame.h")
if(EXISTS "${_removed_http2_frame_umbrella}")
    message(FATAL_ERROR "removed HTTP/2 frame aggregation header was installed")
endif()
set(_installed_response_stream_commit_path
    "${_install_prefix}/include/ruvia/http/detail/server/HttpResponseStreamHead.h")
set(_installed_http1_response_stream_path
    "${_install_prefix}/include/ruvia/http/detail/http1/Http1ServerSemantics.h")
if(NOT EXISTS "${_installed_response_stream_commit_path}" OR
   NOT EXISTS "${_installed_http1_response_stream_path}")
    message(FATAL_ERROR
        "installed HTTP package is missing its response-stream commit contract")
endif()
file(READ "${_installed_response_stream_commit_path}"
    _installed_response_stream_commit)
file(READ "${_installed_http1_response_stream_path}"
    _installed_http1_response_stream)
if(NOT _installed_response_stream_commit MATCHES
       "std::uint16_t responseStatus[(][)] const noexcept" OR
   NOT _installed_response_stream_commit MATCHES
       "HttpResponseBodyPlan bodyPlan[(][)] const noexcept" OR
   NOT _installed_response_stream_commit MATCHES
       "ResponseStreamFraming framing[(][)] const noexcept" OR
   NOT _installed_response_stream_commit MATCHES
       "HttpKnownMethod requestMethod" OR
   NOT _installed_response_stream_commit MATCHES
       "response[.]status[(][)] != commitPlan[.]responseStatus[(][)]" OR
   NOT _installed_http1_response_stream MATCHES
       "httpResponseStreamCommitPlan" OR
   NOT _installed_http1_response_stream MATCHES
       "plan[.]framing[(][)]" OR
   NOT _installed_http1_response_stream MATCHES
       "response[.]status[(][)]")
    message(FATAL_ERROR
        "installed HTTP response-stream plan lost status/framing/body coherence")
endif()
string(CONCAT _removed_response_stream_header
    "${_install_prefix}/include/ruvia/http/HttpBody" "Stream.h")
if(EXISTS "${_removed_response_stream_header}")
    message(FATAL_ERROR "removed dynamic response-body stream header was installed")
endif()
set(_removed_client_types_header
    "${_install_prefix}/include/ruvia/http/HttpClientTypes.h")
if(EXISTS "${_removed_client_types_header}")
    message(FATAL_ERROR "removed Fetch-shaped client model header was installed")
endif()
set(_installed_http_content_coding
    "${_install_prefix}/include/ruvia/http/detail/HttpContentCoding.h")
set(_removed_http_streaming_decoder
    "${_install_prefix}/include/ruvia/http/detail/client/HttpStreamingDecoder.h")
