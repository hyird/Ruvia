file(READ "${_installed_http_content_coding}"
    _installed_http_content_coding_contract)
if(NOT _installed_http_content_coding_contract MATCHES
       "class HttpUnsupportedContentCoding final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "HttpUnsupportedContentCoding::status|static constexpr std::uint16_t status" OR
   NOT _installed_http_content_coding_contract MATCHES
       "httpSupportedRequestContentCodings" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentCodingFieldResult final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "std::variant<HttpContentCoding, HttpUnsupportedContentCoding>" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpDecodedContent final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentDecodeFailure final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentDecodeResult final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "using Value = std::variant" OR
   NOT _installed_http_content_coding_contract MATCHES
       "decodeHttpContent" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpEncodedContent final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentEncodeFailure final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "class HttpContentEncodeResult final" OR
   NOT _installed_http_content_coding_contract MATCHES
       "encodeHttpContent" OR
   _installed_http_content_coding_contract MATCHES
       "HttpContentCoding::kNone|decodeRequestContentEncoding|kMaxDecodedRequestBodyBytes|bool[ \t\r\n]+encodeHttpContent|encodeHttpContent[ \t\r\n]*[(][^)]*std::pmr::string[ \t]*&")
    message(FATAL_ERROR
        "installed HTTP content coding lost its owning discriminated contract")
endif()
set(_installed_http_content_length
    "${_install_prefix}/include/ruvia/http/detail/HttpContentLength.h")
if(NOT EXISTS "${_installed_http_content_length}")
    message(FATAL_ERROR
        "installed HTTP package is missing shared Content-Length state")
endif()
file(READ "${_installed_http_content_length}"
    _installed_http_content_length_contract)
if(NOT _installed_http_content_length_contract MATCHES
       "class HttpContentLengthState" OR
   NOT _installed_http_content_length_contract MATCHES
       "std::optional<std::size_t> value" OR
   NOT _installed_http_content_length_contract MATCHES
       "auto parsedValue = value_" OR
   _installed_http_content_length_contract MATCHES
       "bool present[(]|bool present_|std::size_t value_[{]0[}]")
    message(FATAL_ERROR
        "installed Content-Length state lost transactional optional semantics")
endif()
set(_installed_http_transfer_encoding
    "${_install_prefix}/include/ruvia/http/detail/HttpTransferEncoding.h")
set(_installed_http_transfer_coding_value
    "${_install_prefix}/include/ruvia/http/detail/HttpTransferCoding.h")
if(NOT EXISTS "${_installed_http_transfer_encoding}" OR
   NOT EXISTS "${_installed_http_transfer_coding_value}")
    message(FATAL_ERROR
        "installed HTTP package is missing shared Transfer-Encoding state")
endif()
file(READ "${_installed_http_transfer_encoding}"
    _installed_http_transfer_encoding_contract)
file(READ "${_installed_http_transfer_coding_value}"
    _installed_http_transfer_coding_value_contract)
