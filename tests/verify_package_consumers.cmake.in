   NOT _installed_http2_connection MATCHES
       "Http2StreamingResponseHeadSubmitResult")
    message(FATAL_ERROR "installed HTTP/2 core lost its discriminated response-head submission result")
endif()
set(_installed_http2_event_path
    "${_install_prefix}/include/ruvia/http/detail/http2/Http2Event.h")
if(NOT EXISTS "${_installed_http2_event_path}")
    message(FATAL_ERROR "installed HTTP/2 core is missing its typed event contract")
endif()
file(READ "${_installed_http2_event_path}" _installed_http2_event)
if(NOT _installed_http2_connection MATCHES
       "std::optional<Http2Event>[ \t]+nextEvent" OR
   NOT _installed_http2_event MATCHES "enum class Http2EventKind" OR
   NOT _installed_http2_event MATCHES "using Value = std::variant" OR
   NOT _installed_http2_event MATCHES "class Http2StreamClosedEvent final" OR
   NOT _installed_http2_event MATCHES "Http2StreamCloseSource source" OR
