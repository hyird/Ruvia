set(_source_root "@CMAKE_SOURCE_DIR@")

# Stable repository layout rules from AGENTS.md. This guard intentionally checks
# structural invariants that are cheap to prove from the source tree: target
# directory shape, public include roots, shallow src layout, and target test
# categories. It does not try to encode every naming convention.

function(_ruvia_layout_fail _message)
    message(FATAL_ERROR "ruvia_guard_repo_layout: ${_message}")
endfunction()

function(_ruvia_require_path _path)
    if(NOT EXISTS "${_path}")
        file(RELATIVE_PATH _relative "${_source_root}" "${_path}")
        _ruvia_layout_fail("missing required path: ${_relative}")
    endif()
endfunction()

function(_ruvia_forbid_path _path)
    if(EXISTS "${_path}")
        file(RELATIVE_PATH _relative "${_source_root}" "${_path}")
        _ruvia_layout_fail("forbidden source-level path exists: ${_relative}")
    endif()
endfunction()

function(_ruvia_check_target_layout _target_dir _namespace_root)
    set(_target_path "${_source_root}/${_target_dir}")
    _ruvia_require_path("${_target_path}/CMakeLists.txt")
    _ruvia_require_path("${_target_path}/include")
    _ruvia_require_path("${_target_path}/src")
    _ruvia_require_path("${_target_path}/include/ruvia/${_namespace_root}")

    file(GLOB_RECURSE _include_files LIST_DIRECTORIES FALSE
        "${_target_path}/include/*")
    if(_include_files STREQUAL "")
        _ruvia_layout_fail("${_target_dir}/include has no public headers")
    endif()
    foreach(_include_file IN LISTS _include_files)
        file(RELATIVE_PATH _relative "${_target_path}" "${_include_file}")
        if(NOT _relative MATCHES "^include/ruvia/${_namespace_root}/")
            _ruvia_layout_fail(
                "${_target_dir} owns a header outside include/ruvia/${_namespace_root}: "
                "${_relative}")
        endif()
    endforeach()

    file(GLOB _ruvia_namespace_entries LIST_DIRECTORIES TRUE
        "${_target_path}/include/ruvia/*")
    foreach(_entry IN LISTS _ruvia_namespace_entries)
        get_filename_component(_entry_name "${_entry}" NAME)
        if(NOT _entry_name STREQUAL "${_namespace_root}")
            file(RELATIVE_PATH _relative "${_target_path}" "${_entry}")
            _ruvia_layout_fail(
                "${_target_dir} exposes another target namespace root: ${_relative}")
        endif()
    endforeach()
endfunction()

function(_ruvia_check_src_depth _target_dir _mode)
    set(_src_root "${_source_root}/${_target_dir}/src")
    file(GLOB_RECURSE _src_files LIST_DIRECTORIES FALSE
        "${_src_root}/*")
    foreach(_src_file IN LISTS _src_files)
        file(RELATIVE_PATH _relative "${_src_root}" "${_src_file}")
        if("${_mode}" STREQUAL "flat")
            if(_relative MATCHES "/")
                _ruvia_layout_fail("${_target_dir}/src must stay flat: ${_relative}")
            endif()
        else()
            if(NOT _relative MATCHES "^[^/]+$|^[^/]+/[^/]+$")
                _ruvia_layout_fail(
                    "${_target_dir}/src may use only one classification level: "
                    "${_relative}")
            endif()
        endif()
    endforeach()
endfunction()

function(_ruvia_check_flat_test_dir _test_dir)
    file(GLOB_RECURSE _test_dirs LIST_DIRECTORIES TRUE
        "${_source_root}/${_test_dir}/*")
    foreach(_entry IN LISTS _test_dirs)
        if(IS_DIRECTORY "${_entry}")
            file(RELATIVE_PATH _relative "${_source_root}" "${_entry}")
            _ruvia_layout_fail("${_test_dir} must stay flat, found subdirectory: ${_relative}")
        endif()
    endforeach()
endfunction()

function(_ruvia_check_test_categories _test_dir)
    set(_allowed_categories ${ARGN})
    file(GLOB _entries LIST_DIRECTORIES TRUE
        "${_source_root}/${_test_dir}/*")
    foreach(_entry IN LISTS _entries)
        file(RELATIVE_PATH _relative "${_source_root}" "${_entry}")
        if(NOT IS_DIRECTORY "${_entry}")
            _ruvia_layout_fail(
                "${_test_dir} test sources must be categorized, found: ${_relative}")
        endif()

        get_filename_component(_category "${_entry}" NAME)
        list(FIND _allowed_categories "${_category}" _category_index)
        if(_category_index EQUAL -1)
            string(JOIN ", " _allowed_text ${_allowed_categories})
            _ruvia_layout_fail(
                "${_test_dir} has unsupported category '${_category}'; "
                "allowed categories: ${_allowed_text}")
        endif()
    endforeach()
endfunction()

function(_ruvia_assert_matches _label _pattern _probe)
    string(REGEX MATCH "${_pattern}" _match "${_probe}")
    if(NOT _match)
        _ruvia_layout_fail("self-test failed, pattern lost ${_label}: ${_pattern}")
    endif()
endfunction()

function(_ruvia_assert_ignores _label _pattern _probe)
    string(REGEX MATCH "${_pattern}" _match "${_probe}")
    if(_match)
        _ruvia_layout_fail("self-test failed, pattern matched benign ${_label}: ${_match}")
    endif()
endfunction()

set(_one_level_source_pattern "^[^/]+$|^[^/]+/[^/]+$")
_ruvia_assert_matches(one_level_root "${_one_level_source_pattern}" "Server.cpp")
_ruvia_assert_matches(one_level_category "${_one_level_source_pattern}" "server/Server.cpp")
_ruvia_assert_ignores(two_level_category "${_one_level_source_pattern}" "net/server/Server.cpp")

foreach(_forbidden_root IN ITEMS include src fuzz core http web edge)
    _ruvia_forbid_path("${_source_root}/${_forbidden_root}")
endforeach()

_ruvia_check_target_layout("ruvia-core" "core")
_ruvia_check_target_layout("ruvia-http" "http")
_ruvia_check_target_layout("ruvia-web" "web")
_ruvia_check_target_layout("ruvia-edge" "edge")

_ruvia_check_src_depth("ruvia-core" "flat")
_ruvia_check_src_depth("ruvia-http" "one-level")
_ruvia_check_src_depth("ruvia-web" "one-level")
_ruvia_check_src_depth("ruvia-edge" "one-level")

_ruvia_check_flat_test_dir("tests/core")
_ruvia_check_flat_test_dir("tests/edge")
_ruvia_check_test_categories(
    "tests/http"
    unit http1 http2 websocket guards support conformance benchmarks)
_ruvia_check_test_categories(
    "tests/web"
    unit server guards)

message(STATUS
    "ruvia_guard_repo_layout: target include roots, src depth, and target test "
    "directory rules hold")
